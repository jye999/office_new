{
  "name": "office_new",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "worker": "tsx src/jobs/worker.ts",
    "sync": "tsx src/jobs/sync.ts",
    "pda:api-key": "tsx src/jobs/pda-api-key.ts",
    "faire:import-images": "tsx src/jobs/faire-import-images.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1",
    "parity": "tsx scripts/parity.ts",
    "routes:check": "tsx scripts/routes-check.ts",
    "db:types": "bash -c 'set -a; . ./.env; set +a; kysely-codegen --url \"mysql://$DB_USERNAME:$DB_PASSWORD@$DB_HOST:$DB_PORT/$DB_DATABASE\" --out-file src/db/office.d.ts && kysely-codegen --url \"mysql://$DB_USERNAME:$DB_PASSWORD@$DB_HOST:$DB_PORT/$DB_HWC_DATABASE\" --out-file src/db/hwc.d.ts'"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@fastify/flash": "^6.0.6",
    "@fastify/formbody": "^9.0.1",
    "@fastify/multipart": "^10.1.6",
    "@fastify/secure-session": "^8.4.1",
    "@fastify/static": "^10.1.7",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.4.2",
    "dotenv": "^18.0.8",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "ioredis": "^5.11.1",
    "kysely": "^0.29.7",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.2.1",
    "nunjucks": "^3.2.4",
    "pusher": "^5.3.4",
    "sharp": "^0.35.5",
    "soap": "^1.14.0",
    "ssh2-sftp-client": "^12.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.2",
    "@types/nunjucks": "^3.2.6",
    "kysely-codegen": "^0.20.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
