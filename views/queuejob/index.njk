{% extends "layout.njk" %}
{% block title %}Queue jobs{% endblock %}
{% block content %}
<div class = 'container'>
    <h1>
        Jobs
    </h1>
    <br>
    <a href="/queue.ping">Ping</a>
    <table class = "table table-striped table-bordered">
        <thead>
            <th>ID</th>
            <th>Queue Id</th>
            <th>Job Type</th>
            <th>Order Id</th>
            <th>Created</th>
            <th>Updated</th>
            <th></th>
        </thead>
        <tbody>
            {% for job in jobs %}
            <tr>
                <td>{{ job.id | safe }}</td>
                <td>{{ job.queueId | safe }}</td>
                <td>{{ job.type | safe }}</td>
                <td>
                {{ job.orders | safe }}
                </td>
                <td>{{ job.created_at | safe }}</td>
                <td>{{ job.updated_at | safe }}</td>
                <td>

                    <a target="_blank" href = './queue.print?queueId={{ job.queueId | safe }}' class = 'viewShow btn btn-info btn-xs' ><i class = 'material-icons'>print</i></a>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>


</div>

<script>
$(document).ready(function(){

});
</script>
{% endblock %}
