			}, {
				"sWidth": "50%"
			}, {
				"sWidth": "50px"
			}, {
				"sWidth": "50px"
			}, {
				"sWidth": "50px"
			}, {
				"sWidth": "50px"
			}],
			"aaSorting": [
				[5, "asc"]
			],
			"sDom": "<'row-fluid'<'span6'l><'boutonniereSearch'><'corsageSearch'><'bouquetSearch'><'quickSearch'><'span6'f<'clearSearch'>>r>t<'row-fluid'<'span12'i><'span12 center'p>>",
			"bPaginate": false,
			"oLanguage": {
				"sLengthMenu": "_MENU_ records per page"
			},
			"fnRowCallback": function(nRow, aData) {
			}
		});
        
	 $('a.gallery').click(function(e){
		e.preventDefault();
			var src = $(this).attr('href');


            var value =$(this).find('.variantvalue').text();
            var itemId =$(this).find('.itemIdvalue').text();
		 	var orderId = $(this).find('.orderIdvalue').text();
                //$("#picHolder").html('');
                //$("#picHolder").append('<a class="group1" href="'+src+'" >link</a>');
                //$(".group1").colorbox({rel:'group1',open:true});
                
             getAllEbayPic(orderId,itemId, value);
	});
	
    

    $(".addTrackBtn").click(function() {
        var transitem = $(this).val().replace("-","_");
        window.open('http://payments.ebay.com/ws/eBayISAPI.dll?AddTrackingNumber2&LineID=Transactions.' + transitem	);
    });
    });
	</script>
{% endblock %}
