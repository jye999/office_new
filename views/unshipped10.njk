{% extends "unshipped_layout.njk" %}
{% block content %}
    <table class="table table-bordered table-condensed" id="orders" style="width:100%">
        <thead>
            <tr>
                <th><input type="checkbox" id="chkAll"></th>
                <th>Order Number</th>
                <th>Product Name</th>
                <th>Order Qty</th>
                <th>Product Picture</th>
                <th>Ship Date</th>
                <th>Total Qty</th>
                <th>days-past</th>
                <th>Print</th>
            </tr>
        </thead>
        <tbody>
            {% for order in orders %}
                {% for item in order.detail %}
            <tr class='orderTr {{ "made" if (isset(item.made) and item.made=="Y") else "" }} {{ "inprogress" if (isset(item.made) and item.made=="P") else "" }}  {{ "halfmade" if (isset(item.made) and item.made=="H") else "" }} {{ item.priorityFlag }}'>

                
                <td>      
                <input type="checkbox" class="action" value="{{ item.orderId }}"> 
                {% if order.country!='US' %}
                <i class="glyphicon glyphicon-globe"></i>{{ order.country }}
                {% endif %}
                <br/>
                </td>
                
                <td>{{ item.orderId }} 
                <span style="display:none" class="store">{{ item.store }}</span>  
                    <span class="orderSpan" style="display:none">{{ item.orderId }}</span>
                    <a class="anchor" id="{{ substr(item.orderId,-7) }}">{{ item.orderId }} </a>
                    <br/>
                    {{ order.multiOrdersHtml | safe }}
                    <br/>
                    <button class="btn btn-primary btn-lg prioritizeBtn" value="{{ item.orderId }}">
                        {{ order.prioritizeBtnText }}
                    </button>
                    
                </td>
                <td>
                	<a class="desclink" href="ebayDesc?itemId={{ item.itemID0 }}" target="_blank">
                        {{ item.name }}</a><br/>
                <span style='color:black'> {{ str_replace("|",":",item.variation) }} </span>
				<span style='color:orange'> 
					{{ item.notesFromBuyerHtml | safe }}
					{{ item.selfNotesHtml | safe }}
				</span>
                    <br/>
                    <textarea class="notes" >{{ (item.notes if isset(item.notes) else '') | safe }}</textarea><br/>
                    <button class="saveNote" value="{{ item.id }}">Save</button>
                    <br/><span>Buyer : <a href="#" class="searchBuyer">{{ order.buyer }}</a></span>
                </td>
                <td style="font-weight:bold;font-size:16pt;{{ 'color:#1e9ffe' if item.qty>1 else '' }}">{{ item.qty }}</td>
                <td>
                <a class="gallery" href="{{ item.image }}"><img src="{{ item.image }}" style="width:300px" class="itemImage">
                        <span class="orderIdvalue" style="display:none">{{ item.orderId }}</span>
						<span class="variantvalue" style="display:none">{{ item.variationValue }}</span>
						<span class="itemIdvalue" style="display:none">{{ item.itemID0 }}</span>
						</a></td>
				<td>
                    <span>
                        {{ item.shipDate }}</span>
                    <input type="text" type="text" class="form-control shipdate" value="{{ order.promiseDate }}">
    				<button value="{{ order.orderId }}" class="saveShipDateBtn">Update</button>
                </td>
                <td>{{ itemStats['a'+item.asin] if 'a'+item.asin in itemStats else '' }} </td>
                <td></td>

                <td>
                <!--
                  20 - FedEx Ground
25 - FedEx Ground(Residential over 70 lbs)
67 - FedEx Home Delivery
501 - UPS Ground - DSV
                  -->
                {% if hasRole(['user','admin']) %}
                {{ item.shipLevel }}
                <button class="btn btn-primary progressBtn {{ 'invisible' if (isset(item.made) and item.made=='Y') else '' }}"  value="{{ item.id }}">
                     {{ "In Progress" if (isset(item.made) and item.made=="P") else "Start Process" }}
                    </button>
                    <button class="btn btn-primary  madeBtn" value="{{ item.id }}">
                        {{ "Unmade" if (item.made is not none and item.made != '' and item.made != '0') else "Made" }}
                    </button><br/><br/>

                    {% if hasRole(['packing','admin']) %}
                    <button class="btn btn-primary doneBtn" value="{{ item.orderId }}">
                        Done
                    </button>

                {% if item.shipLevel=='31' or item.shipLevel=='30' %}
                    <button class="btn btn-primary labelBtn actionBtn" value="{{ item.orderId }}">USPS Priority</button>
                {% endif %}
                {% if item.shipLevel=='67' %}
                    <button class="btn btn-primary fedexPrint actionBtn" value="{{ item.orderId }}">Fedex Home</button>
                {% endif %}
                {% if item.shipLevel=='68' or item.shipLevel=='20' %}
                    <button class="btn btn-primary fedexPrint actionBtn" value="{{ item.orderId }}">Fedex Ground</button>
                {% endif %}
                
                {% if item.shipLevel=='501' %}
                    <button class="btn btn-primary upsPrint actionBtn" value="{{ item.orderId }}">UPS Ground</button>
                {% endif %}
               
					<button class="btn btn-primary addTrackBtn" value="{{ item.itemId }}">
						Add Tracking
					</button>
                {% endif %}
                {% endif %}
                </td>
            </tr>
            {% endfor %}
            {% endfor %}

        </tbody>
        <tfoot>
            <tr>
                <th>End</th>
                <th><span id="total_span"></span></th>
            </tr>
        </tfoot>
    </table>
    
	<script>
        
    var currentStore='D';
    
	$(document).ready(function() {
		$("#unshipped10").addClass("active");
        var groupColumn =0;
        
		oTable = $('#orders').DataTable({
			"aoColumns": [{
				"sWidth": "50px"
			}, {
				"sWidth": "75px"
			}, {
				"sWidth": "150px"
			}, {
				"sWidth": "50px"
			}, {
				"sWidth": "50%"
			}, {
				"sWidth": "50px"
			}, {
				"sWidth": "50px"
			}, {
				"sWidth": "50px"
			}, {
				"sWidth": "50px"
			}],
			"aaSorting": [
				[5, "asc"]
			],
			"sDom": "<'row-fluid'<'span6'l><'boutonniereSearch'><'corsageSearch'><'bouquetSearch'><'quickSearch'><'span6'f<'clearSearch'>>r>t<'row-fluid'<'span12'i><'span12 center'p>>",
			"bPaginate": false,
			"oLanguage": {
				"sLengthMenu": "_MENU_ records per page"
			},
			"fnRowCallback": function(nRow, aData) {
			}
		});
        
});
	
	</script>
{% endblock %}
