{% extends "layout.njk" %}
{% block content %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.6.0/css/bootstrap-datepicker.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.6.0/js/bootstrap-datepicker.min.js"></script>

<link rel="stylesheet/less" type="text/css" href="css/timepicker.less" />
<script src="js/bootstrap-timepicker.js"></script>

<div class="form-group row">
	<div class="col-sm-1">
		<span >Start</span>
	</div>
	<div class="col-sm-2">
		<input type="text" class="form-control"  id="startdate">
	</div>
	<div class="col-sm-1">
			<span >End</span>
	</div>
	<div class="col-sm-2">
		<input type="text" class="form-control"  id="enddate">
	</div>
	<div class="col-sm-2">		
		<button class="btn btn-primary" id="runTimesheet">Run</button>
	</div>
</div>
<div id="divTimesheet" class="row">
	<div class="row">
		<hr/>
		<h3>Report</h3>
	</div>

	<div class="row">
		<table id="reporttable" class="table table-stripe table-hover table-collapse">
			<thead>
				<tr>
					<td>Staff</td>
					<td>Hours</td>
				</tr>
			</thead>
			<tbody>
			</tbody>
		</table>
	</div>
</div>

<script>
$(document).ready(function(){
	$("#startdate").datepicker({autoclose:true,format:'yyyy-mm-dd',todayHighlight:true});
	$("#enddate").datepicker({autoclose:true,format:'yyyy-mm-dd',todayHighlight:true});

	var getStaffTimesheetReport = function(staff){
        $.ajax({
            type: 'get',
            dataType: 'json',
            url: '{{ route("getTimesheetRangeReport") }}',
            data: {
                "start": $("#startdate").val(),
                "end": $("#enddate").val()
            },
            success: function(r) {
            	console.dir(r);

            	$("#reporttable").show();
            	$("#reporttable tbody").html('');
            	for(var i=0;i<r.length;i++){
	            	var rowStr = "<tr>";
	            	rowStr += "<td>"+ r[i].staff +"</td>";
	            	rowStr += "<td>"+ r[i].workhours+"</td>";
	            	rowStr+="</tr>";
	            	$("#reporttable tbody").append(rowStr);
            	}
            },
            error: function(e) {
                console.log('oops');
                console.dir(e);
            }
        });

	};
	$("#runTimesheet").click(function(){
		getStaffTimesheetReport();
	});

        
});
</script>
{% endblock %}
