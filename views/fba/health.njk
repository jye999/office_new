{% extends "layout.njk" %}
{% block content %}
    <table class="table table-bordered table-condensed" id="fba" >
        <thead>
            <tr>
                <th>asin</th>
                <th>fnsku</th>
                <th>product</th>
                <th>picture</th>
                <th>sellable qty</th>
                <th>weeks of cover</th>
                <th>in bound qty</th>
                <th>Recommend</th>
                <th>long term storage</th>
                <th>unsellable qty</th>
                <th>24 Hrs</th>
                <th>7 Days</th>
                <th>30 Days</th>
                <th>90 Days</th>
                <th>365 Days</th>
                <th>sales-rank</th>
                <th># of seller</th>
                <th>date</th>
                </tr>
        </thead>
        <tbody>
        {% for f in fbaHealth %}
            <tr>
            <td>{{ f.asin }}</td>
            <td>{{ f.fnsku }}</td>
            <td>{{ f['product-name'] }}</td>
            <td><img data-original="/images/{{ f.asin }}.jpg" class="itemImage" src="/images/{{ f.asin }}.jpg" style="display: inline;width:150px"> </td>
            <td>{{ f['sellable-quantity'] }}</td>
            <td>{{ f['weeks-of-cover-t7'] }}</td>
            <td>{{ f['in-bound-quantity'] }}</td>
            <td>{{ f['inbound-recommend-quantity'] }}</td>
            <td>{{ f['qty-in-long-term-storage-program'] }}</td>
            <td>{{ f['unsellable-quantity'] }}</td>
            <td>{{ f['units-shipped-last-24-hrs'] }}</td>
            <td>{{ f['units-shipped-last-7-days'] }}</td>
            <td>{{ f['units-shipped-last-30-days'] }}</td>
            <td>{{ f['units-shipped-last-90-days'] }}</td>
            <td>{{ f['units-shipped-last-365-days'] }}</td>
            <td>{{ f['sales-rank'] }}</td>
            <td>{{ f['num-afn-new-sellers'] }}</td>
            <td>{{ f['snapshot-date'] }}</td>
            </tr>

        {% endfor %}
        </tbody>
    </table>
    <script>
$(document).ready(function(){

		oTable = $('#fba').DataTable({
			// "aoColumns": [{
			// 	"sWidth": "10px"
			// }, {
