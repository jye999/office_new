{% extends "layout.njk" %}
{% block content %}
    <table class="table table-bordered table-condensed" id="fba" >
        <thead>
            <tr>
                <th>asin</th>
                <th>sku</th>
                <th>fnsku</th>
                <th>picture</th>
                <th>qty</th>
                <th>condition</th>
                </tr>
        </thead>
        <tbody>
        {% for f in fbaInventory %}
            <tr>
            <td>{{ f.asin }}</td>
            <td>{{ f.sku }}</td>
            <td>{{ f.afnsku }}</td>
            <td><img data-original="/images/{{ f.asin }}.jpg" class="itemImage" src="/images/{{ f.asin }}.jpg" style="display: inline;width:150px"> </td>
            <td>{{ f.qty }}</td>
            <td>{{ f.conditionTye }}</td>
            </tr>

        {% endfor %}
        </tbody>
    </table>
