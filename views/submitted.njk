{% extends "layout.njk" %}
{% block content %}
<button id="uploadTracking" class="btn btn-primary">Upload</button>
    <table class="table table-bordered table-condensed" id="orders" >
        <thead>
            <tr>
                <th>Store</th>
                <th>Order Id</th>
                <th>Item Id</th>
                <th>Status</th>
                <th>Tracking</th>
            </tr>
        </thead>
        <tbody>
        {% for order in orders %}
            {% for item in order.detail %}
            <tr>
                <td>{{ order.store }}</td>
                <td>{{ item.orderId }}</td>
                <td>{{ item.itemId }}</td>
                <td>{{ order.status }}</td>
                <td>{% for t in order.tracking %}{{ cat(t.tracking, '<br>') | safe }}{% endfor %}</td>
            </tr>
            {% endfor %}
        {% endfor %}

        </tbody>
    </table>
   
   <script>

	$(document).ready(function() {
		$("#uploadTracking").click(function(e){
            e.preventDefault();
            $.ajax({
                type : 'post',
                url : '{{ route('UploadTracking') }}',
                success : function(r)
                {
                    console.log("ok");
                },
                error: function(r){
                    console.log("err");
                }
            });
            
        });
	});
	
	</script>
{% endblock %}