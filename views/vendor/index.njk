{% extends "layout.njk" %}

{% block content %}
<div class="container">
    <h1>Vendors <small><a href="/ListProducts">&larr; back to Products</a></small></h1>
    <p class="text-muted">Each product (SKU) can have one vendor. Assign vendors from the Products page.</p>

    <div id="vendor-msg" class="alert" style="display:none;"></div>

    <table class="table table-bordered table-striped table-condensed" id="vendor-table" style="max-width:900px;">
        <thead>
            <tr>
                <th>Name</th>
                <th>Notes</th>
                <th style="width:90px;">Products</th>
                <th style="width:150px;"></th>
            </tr>
        </thead>
        <tbody>
        {% for v in vendors %}
            <tr data-id="{{ v.id }}" data-count="{{ v.sku_count }}">
                <td><input type="text" class="form-control input-sm v-name" maxlength="100" value="{{ v.name }}"></td>
                <td><input type="text" class="form-control input-sm v-notes" value="{{ v.notes if v.notes else '' }}"></td>
                <td class="v-count">{{ v.sku_count }}</td>
                <td>
                    <button type="button" class="btn btn-primary btn-xs v-save">Save</button>
                    <button type="button" class="btn btn-danger btn-xs v-delete">Delete</button>
                </td>
            </tr>
        {% endfor %}
        </tbody>
        <tfoot>
            <tr class="info">
                <td><input type="text" class="form-control input-sm" id="new-name" maxlength="100" placeholder="New vendor name"></td>
                <td><input type="text" class="form-control input-sm" id="new-notes" placeholder="Notes (optional)"></td>
                <td></td>
                <td><button type="button" class="btn btn-success btn-xs" id="add-vendor">Add vendor</button></td>
            </tr>
        </tfoot>
    </table>
</div>

<script>
$(function () {
    function say(ok, text) {
        $('#vendor-msg').removeClass('alert-success alert-danger').addClass(ok ? 'alert-success' : 'alert-danger').text(text).show();
    }
    function fail(xhr) {
        var m = (xhr.responseJSON && xhr.responseJSON.message) || 'Something went wrong';
        say(false, m);
    }
    function rowHtml(v) {
        var $tr = $('<tr>').attr({'data-id': v.id, 'data-count': v.sku_count});
        $tr.append($('<td>').append($('<input type="text" class="form-control input-sm v-name" maxlength="100">').val(v.name)));
        $tr.append($('<td>').append($('<input type="text" class="form-control input-sm v-notes">').val(v.notes || '')));
        $tr.append($('<td class="v-count">').text(v.sku_count));
        $tr.append($('<td>').append('<button type="button" class="btn btn-primary btn-xs v-save">Save</button> <button type="button" class="btn btn-danger btn-xs v-delete">Delete</button>'));
        return $tr;
    }

    $('#add-vendor').on('click', function () {
        $.post('/api/vendors', { name: $('#new-name').val(), notes: $('#new-notes').val() })
            .done(function (v) {
                $('#vendor-table tbody').append(rowHtml(v));
                $('#new-name, #new-notes').val('');
                say(true, 'Added "' + v.name + '"');
            })
            .fail(fail);
    });
    $('#new-name').on('keyup', function (e) { if (e.which === 13) $('#add-vendor').click(); });

    $('#vendor-table').on('click', '.v-save', function () {
        var $tr = $(this).closest('tr');
        $.post('/api/vendors/' + $tr.data('id'), { name: $tr.find('.v-name').val(), notes: $tr.find('.v-notes').val() })
            .done(function (v) { $tr.find('.v-name').val(v.name); say(true, 'Saved "' + v.name + '"'); })
            .fail(fail);
    });

    $('#vendor-table').on('click', '.v-delete', function () {
        var $tr = $(this).closest('tr');
        var name = $tr.find('.v-name').val();
        if (!confirm('Delete vendor "' + name + '"?')) return;
        $.ajax({ url: '/api/vendors/' + $tr.data('id'), type: 'DELETE' })
            .done(function () { $tr.remove(); say(true, 'Deleted "' + name + '"'); })
            .fail(fail);
    });
});
</script>
{% endblock %}
