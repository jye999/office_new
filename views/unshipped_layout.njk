                      <td></td><td>SKU</td><td class="hidden-xs">NAME</td><td class="hidden-xs">Image</td>
                      </tr>
                    </thead>
                    <tbody>
                    </tbody>
                    </table>
                </div>
              </div>
            </div>
      </div>


      <div class="modal fade" id="skuModal" tabindex="-1" role="dialog" aria-hidden="true">
      <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <span id="skuTitle"></span>
                </div>
                <div class="modal-body" >
                 SKU: <span id="skuText"></span><br/>
                  <div id="skuLocation"></div>
                  <div id="skuImages"></div>
                </div>
              </div>
            </div>
      </div>

</body>
<script>
    var productDataLoaded = false;
    var externalSku = '';
    var externalAsin = '';
    function findBootstrapEnvironment() {
        var envs = ['xs', 'sm', 'md', 'lg'];

        var $el = $('<div>');
        $el.appendTo($('body'));

        for (var i = envs.length - 1; i >= 0; i--) {
            var env = envs[i];

            $el.addClass('hidden-'+env);
            if ($el.is(':hidden')) {
                $el.remove();
                return env;
            }
        }
    }

    $(document).ready(function(){
        //$(".fedexPrint").hide();

    function loadProducts(){
        if(productDataLoaded==false){
        $.ajax({
            type:'get',
            datatype: 'json',
            url: '/api/products',
            success: function(r) {
                var rowHtml='';
                for(var i=0;i<r.products.length;i++){

                    rowHtml='<tr><td><button class="btn btn-sm btn-primary btnSelectMatch" value="'+r.products[i].sku+'">Select</button></td>';
                    rowHtml+='<td>';
                    rowHtml+='<p class="hidden-lg hidden-md hidden-sm">'+r.products[i].name+'</p>';

                    rowHtml+='<img class="hidden-lg hidden-md hidden-sm" width="100px" src="'+((r.products[i].images!=null && r.products[i].images.length>0)?'/storage/product_images_icon/'+r.products[i].images[0].filename:'')+'">';

                    rowHtml+=r.products[i].sku;
                    for(var j=0;j<r.products[i].locations.length;j++){
                        rowHtml+="<br>"+   r.products[i].locations[j].location + " x "+r.products[i].locations[j].qty;
                    }
                    rowHtml+='</td><td class="hidden-xs">'+r.products[i].name+'</td><td class="hidden-xs"><img src="'+((r.products[i].images!=null && r.products[i].images.length>0)?'/storage/product_images_icon/'+r.products[i].images[0].filename:'')+'"></td></tr>'
                    $("#skuTable tbody").append(rowHtml);
                }
                $("#skuTable").DataTable();
                productDataLoaded = true;
            },
            error: function(err){
                console.dir(err);
            }
        });
        }
    }

	$(".btnFindMatch").click(function(e){

        loadProducts();
        target_row = $(this).closest("tr").get(0);
        currentStore = $(target_row).find(".store").first().text();
        itemName = $(target_row).find(".itemName").first().text();
        externalSku = $(target_row).find(".externalSku").first().text();
        externalAsin = $(target_row).find(".externalAsin").first().text();
        //store = $(target_row).find(".store").first().text();

        // console.log(store);
        // console.log(itemName);
        // console.log(externalSku);
        // console.log(externalAsin);
        $("#matchTitle").text(itemName);
        $("#selectMatchModal").modal('show');
    });

var findAndReplaceSku = function(externalSku, externalAsin, interalSku, locationText){
    $('#orders > tbody  > tr').each(function() {
        var externalSkuElementText = $(this).find('.externalSku').first().text();
        var externalAsinElementText = $(this).find('.externalAsin').first().text();
        var skuLocationElement = $(this).find('.skuLocation').first();
        if(skuLocationElement!=null){
            if((externalSku!='' && externalSku==externalSkuElementText )
            ||
            (externalAsin!='' && externalAsin==externalAsinElementText)){
                skuLocationElement.html(locationText);
            }
        }
    });
};

  $(document).on('click','.btnSelectMatch',function(e){
    e.preventDefault();
    target_row = $(this).closest("tr").get(0);
    var sku = $(this).val();
    var qty = prompt("Please enter matching qty", "");
    var data ={
      store: currentStore,
      externalSku: externalSku,
      externalAsin: externalAsin,
      sku: sku,
      qty: qty
    };

    var thisBtn = $(this);
    $(thisBtn).text('saving...');
    $(thisBtn).prop('disabled',true);
    $.ajax({
        type: 'post',
        url: '{{ route('updateProductMap') }}', // in here you should put your query
        data: data, // here you pass your id via ajax .
        // in php you should use $_POST['post_id'] to get this value
        success: function(result) {
            console.dir(result);
            if(result!="OK"){
              alert(result);
            }
            $("#selectMatchModal").modal('hide');
            $(target_row).find('.btnFindMatch').first().hide();

            var internalSkuElement = $(target_row).find('.internalSku').first();
            internalSkuElement.text(sku);
            var skuLocationElement = $(target_row).find('.skuLocation').first();
            if(skuLocationElement!=null){
                skuLocationElement.text('');
            }

            $(thisBtn).text('Select');
            $(thisBtn).prop('disabled',false);
            $.ajax({
                type: 'get',
                url: '{{ route('product.sku') }}', // in here you should put your query
                data: {'sku':sku}, // here you pass your id via ajax .
                // in php you should use $_POST['post_id'] to get this value
                success: function(result) {
                    console.dir(result);
                    $("#skuTitle").text(result.name);
                    $("#skuText").text(result.sku);

                    var locationHtml='<br/>location: <br/>' ;
                    for(var i=0;i<result.locations.length;i++){
                        locationHtml += result.locations[i].location+" - "+result.locations[i].qty+"<br/>";
                    }

                    if(skuLocationElement!=null){
                        skuLocationElement.html(locationHtml);
                    }

                    findAndReplaceSku(externalSku,externalAsin,sku,locationHtml);
                },
                error: function(xhr, textStatus, errorThrown) {
                    alert('request failed');
                    $("#skuTitle").text('failed to load');
                }
            });

        },
        error: function(xhr, textStatus, errorThrown) {
            alert('request failed');
        }
    });
  });
    });
    </script>
</html>
