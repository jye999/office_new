    $(".prioritizeBtn").click(function() {
        var orderId = $(this).val();
        var hp = 1;
        var newText = 'UnPrioritize';
        var btn = $(this);
        if ($(this).text().trim() == 'Urgent') {
            hp = 2;
            newText = 'UnPrioritize';
        }
        if ($(this).text().trim() == 'Prioritize') {
            hp = 1;
            newText = 'Urgent';
        }
        if ($(this).text().trim() == 'UnPrioritize') {
            hp = 0;
            newText = 'Prioritize';
        }
        target_row = $(this).closest("tr").get(0);
        $.ajax({
            type: 'post',
            url: priorityUrl, // in here you should put your query
            data: 'orderId=' + orderId + "&hp=" + hp, // here you pass your id via ajax .
            // in php you should use $_POST['post_id'] to get this value
            success: function(r) {
                if ($(btn).text().trim() == 'Prioritize') {
                  recordAction(orderId + " -> Prioritize");
                    $(target_row).addClass("priority");
                }
                else if ($(btn).text().trim() == 'Urgent') {
                  recordAction(orderId + " -> Urgent");
                    $(target_row).addClass("urgent");
                } else {
                  recordAction(orderId + " -> not Prioritize");
                    $(target_row).removeClass("priority").removeClass("urgent");
                }
                $(btn).text(newText);


                Echo.private('order')
                    .whisper('order-update', {
                        orderId: orderId,
                        status: newText
                    });

                filterAction();
            }
        });
    });

