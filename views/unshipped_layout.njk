function verifyAddress(){
//check cleanse address
    var address = {
        FullName: $("#fullname").val(),
        Address1: $("#address1").val(),
        Address2: $("#address2").val(),
        City: $("#city").val(),
        State: $("#state").val(),
        ZIPCode: ($("#country").val()!='US'?$("#postalcode").val():$("#zipcode").val().substring(0, 5)),
        PostalCode: $("#postalcode").val(),
        Country: $("#country").val(),
        PhoneNumber: $("#phone").val()
        //order: $("#order-id").val()
    };
    $("#sugguessedAddress").html("Verifying address");
    $.ajax({
        type: 'post',
        url: '{{ route('checkCleanseAddress') }}', // in here you should put your query
        data: {
            "address": address
            },
        success: function(resp) {
            console.log('cleansed');
            console.dir(resp);
            if(resp.success!="true"){
                if(resp.response!=null){
                    var html="<span style='color:red' >"+resp.response.AddressCleansingResult+"<span><br/>";
                    html += resp.response.Address.FullName+"<br/>";
                    html += resp.response.Address.Address1+"<br/>";
                    html += resp.response.Address.Address2+"<br/>";
                    html += resp.response.Address.City+", ";
                    html += resp.response.Address.State+" ";
                    html += resp.response.Address.ZIPCode+"<br/>";
                    $("#sugguessedAddress").html(html);
                }
                else{
                    var html="<span style='color:red' >"+resp.message+"<span><br/>";
                    $("#sugguessedAddress").html(html);
                }
            }
            else{
                $("#sugguessedAddress").html("<span style='color:green' >Address Verified<span>");
            }
        },
        error: function(xhr, textStatus, errorThrown) {
            alert('request failed');
        }
    });
    //end check cleanse address
}
$("#verifyBtn").click(function() {
    verifyAddress();
});


