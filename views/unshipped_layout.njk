    function handleOrderUpdate(data){
        if (typeof data.orderId !== 'undefined')
        {
            var orderId = data.orderId;
            var status = data.status;
            $('#orders > tbody  > tr').each(function(index, value ) {
                if($(this).find("span.orderSpan").text()==orderId){
                    if(status == "done"){
                        $(this).css("display","none");
                        var t = $(this).closest(".orderTr").get(0);
                        oTable.row(t).remove().draw();
                    }
                }
            });
        }
        else if (typeof data.itemId !== 'undefined')
        {
            var itemId = data.itemId;
            var status = data.status;
            var note = data.note;
            $('#orders > tbody  > tr').each(function(index, value ) {

                    if($(this).find(".madeBtn").val()==itemId){
                        var target_row = $(this).closest(".orderTr").get(0);
                        console.log(target_row);
                        //var aPos = oTable.fnGetPosition(target_row);
                        if (typeof status !== 'undefined')
                        {
                            if (status == "startprocess") {
                                $(target_row).removeClass("inprogress");
                                $(target_row).find(".progressBtn").text('Start Process');
                            }
                            else if (status  == "inprogress") {
                                $(target_row).addClass("inprogress");
                                $(target_row).find(".progressBtn").text('In Progress');
                            }
                            else if (status  == "made") {
                                $(target_row).removeClass("inprogress");
                                $(target_row).addClass("made");
                                $(target_row).find(".progressBtn").hide();
                                $(target_row).find(".madeBtn").text('Unmade');
                            }
                            else if (status  == "unmade") {
                                $(target_row).removeClass("made");
                                $(target_row).find(".progressBtn").show();
                                $(target_row).find(".madeBtn").text('Made');
                            }
                            else if (status  == "UnPrioritize") {
                                $(target_row).removeClass("priority");
                                $(target_row).removeClass("urgent");
                                $(target_row).find(".prioritizeBtn").text('Prioritize');
                            }
                            else if (status  == "Prioritize") {
                                $(target_row).addClass("priority");
                                $(target_row).find(".prioritizeBtn").text('Urgent');
                            }
                            else if (status  == "Urgent") {
                                $(target_row).addClass("urgent");
                                $(target_row).find(".prioritizeBtn").text('UnPrioritize');
                            }
                        }
                        if (typeof note !== 'undefined')
                        {
                            var noteObj = $(target_row).find(".notes").val(note);
                        }
                    }
            });
            oTable.draw(false);
        }
    }

