    var filterAction = function() {
        var priorityChk = $("#priorityChk").prop('checked');
        var urgentChk = $("#urgentChk").prop('checked');
        var processingChk =$("#processingChk").prop('checked');
        var madeStatus = $("#filterMade").val();
        var singleChk = $("#singleChk").prop('checked');
        // var assignedName = $("#filterAssign").val();

        $('#orders > tbody  > tr').each(function() {
            var toShow = true;
            if (priorityChk && !$(this).hasClass("priority")) {
                toShow = false;
            }
            if (urgentChk && !$(this).hasClass("urgent")) {
                toShow = false;
            }
            if (processingChk && !$(this).hasClass("inprogress")) {
                toShow = false;
            }

            if (madeStatus == 'Made' && !$(this).hasClass("made")) {
                toShow = false;
            }
            if (madeStatus == 'Not Made' && ($(this).hasClass("made") || $(this).hasClass("halfmade"))) {
                toShow = false;
            }
            if (singleChk && $(this).text().indexOf("Multi-orders") > 0) {
                toShow = false;
            }
            // if(assignedName!='' && $(this).find(".assignSel").val().indexOf(assignedName)<0){
            //     toShow = false;
            // }

            if (!toShow) {
                $(this).hide();
            } else {
                $(this).show();
            }
        });
    };

    $(".madeBtn").click(function() {
        var orderId = $(this).val();
        target_row = $(this).closest(".orderTr").get(0); // this line did the trick

        var btn = $(this);
        $.ajax({
            type: 'post',
            url: madeUrl, // in here you should put your query
            data: 'orderId=' + orderId, // here you pass your id via ajax .
            // in php you should use $_POST['post_id'] to get this value
            success: function(r) {
                if (r == "1") {
                  recordAction(orderId + " -> made");
                    $(target_row).addClass("made");
                    $(target_row).find(".progressBtn").hide();
                    $(btn).text('Unmade');
                    Echo.private('order')
                    .whisper('order-update', {
                        itemId: orderId,
                        status: "made"
                    });
                } else {
                  recordAction(orderId + " -> not made");
                    $(target_row).removeClass("made");
                    $(target_row).find(".progressBtn").removeClass("invisible");
                    $(target_row).find(".progressBtn").show();
                    $(btn).text('Made');
                    Echo.private('order')
                    .whisper('order-update', {
                        itemId: orderId,
                        status: "unmade"
                    });
                }

                filterAction();
            }
        });
    });

