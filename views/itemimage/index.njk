{% extends "scaffold-interface/layouts/app.njk" %}

{% block content %}

<section class="content">
    <h1>
        Itemimage Index
    </h1>
    <form class = 'col s3' method = 'get' action = '{{ url("itemimage") }}/create'>
        <button class = 'btn btn-primary' type = 'submit'>Create New itemimage</button>
    </form>
    <br>
    <br>
    <table class = "table table-striped table-bordered table-hover" style = 'background:#fff'>
        <thead>
            <th>path</th>
            <th>isPrimary</th>
            <th>itemId</th>
            <th>actions</th>
        </thead>
        <tbody>
            {% for itemimage in itemimages %}
            <tr>
                <td>{{ itemimage.path | safe }}</td>
                <td>{{ itemimage.isPrimary | safe }}</td>
                <td>{{ itemimage.itemId | safe }}</td>
                <td>
                    <a data-toggle="modal" data-target="#myModal" class = 'delete btn btn-danger btn-xs' data-link = "/itemimage/{{ itemimage.id }}/deleteMsg" ><i class = 'material-icons'>delete</i></a>
                    <a href = '#' class = 'viewEdit btn btn-primary btn-xs' data-link = '/itemimage/{{ itemimage.id }}/edit'><i class = 'material-icons'>edit</i></a>
                    <a href = '#' class = 'viewShow btn btn-warning btn-xs' data-link = '/itemimage/{{ itemimage.id }}'><i class = 'material-icons'>info</i></a>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {{ itemimagesRender | safe }}

</section>
{% endblock %}
