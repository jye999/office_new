{% extends "scaffold-interface/layouts/app.njk" %}

{% block content %}

<section class="content">
    <h1>
        Show itemimage
    </h1>
    <br>
    <form method = 'get' action = '{{ url("itemimage") }}'>
        <button class = 'btn btn-primary'>itemimage Index</button>
    </form>
    <br>
    <table class = 'table table-bordered'>
        <thead>
            <th>Key</th>
            <th>Value</th>
        </thead>
        <tbody>
            <tr>
                <td>
                    <b><i>path : </i></b>
                </td>
                <td>{{ itemimage.path | safe }}</td>
            </tr>
            <tr>
                <td>
                    <b><i>isPrimary : </i></b>
                </td>
                <td>{{ itemimage.isPrimary | safe }}</td>
            </tr>
            <tr>
                <td>
                    <b><i>itemId : </i></b>
                </td>
                <td>{{ itemimage.itemId | safe }}</td>
            </tr>
        </tbody>
    </table>
</section>
{% endblock %}
