	$(document).ready(function() {
		$("#PendingShipment").addClass("active");
        
		var oTable = $('#orders').dataTable({
			"aoColumns": [{
				"sWidth": "50px"
			}, {
				"sWidth": "75px"
			}, {
				"sWidth": "150px"
			}, {
				"sWidth": "50px"
			}, {
				"sWidth": "50%"
			}, {
				"sWidth": "50px"
			}, {
				"sWidth": "50px"
			}, {
				"sWidth": "50px"
			}],
			"aaSorting": [
				[5, "asc"]
			],
			"sDom": "<'row-fluid'<'span6'l><'span6'f>r>t<'row-fluid'<'span12'i><'span12 center'p>>",
			"bPaginate": false,
			"oLanguage": {
				"sLengthMenu": "_MENU_ records per page"
			},
			"fnRowCallback": function(nRow, aData) {
				var days = aData[5]; // ID is returned by the server as part of the data
				var $nRow = $(nRow); // cache the row wrapped up in jQuery
				if (days > -1) {
					$nRow.css({
						//"color": "red"
					})
				} else if (days > -2) {
					$nRow.css({
						"color": "orange"
					})
				}
				return nRow
			}
		});

		//$('a.gallery').colorbox();
		//oTable.rowGrouping({iGroupingColumnIndex:0, sGroupBy: "order", bHideGroupingColumn: true});

		$(".finishBtn").click(function(){
            var orderId = $(this).val();
            if (confirm('Do you want to print label before close this order?')) {
                printOrderLabel(orderId);
            } 
            if (confirm('Are you sure you want to close this order?')) {
                    
                $.ajax({
                        type: 'post',
                        url: '{{ route('doneOrder') }}', // in here you should put your query 
                        data: 'orderId=' + orderId, // here you pass your id via ajax .
                        // in php you should use $_POST['post_id'] to get this value 
                        success: function(order) {
                            removeRowByOrderId(orderId);

                        },
                        error: function(xhr, textStatus, errorThrown) {
                            alert('request failed');
                        }
                    });
            } 
        });

		$(".showlabelBtn").click(function(e) {
            e.preventDefault();
			var orderId = $(this).val();
            console.log(orderId);
			printOrderLabel(orderId);
		});

		
	});
	
	</script>
    <script src="{{ asset('assets/js/unshipped.js') }}"></script>
{% endblock %}
