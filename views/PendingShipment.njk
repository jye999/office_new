{% extends "unshipped_layout.njk" %}
{% block content %}

    <table class="table table-bordered table-condensed" id="orders" >
        <thead>
            <tr>
                <th></th>
                <th>Order Number</th>
                <th>Product Name</th>
                <th>Order Qty</th>
                <th>Product Picture</th>
                <th>Total Qty</th>
                <th>days-past</th>
                <th>Print</th>
            </tr>
        </thead>
        <tbody>
            {% for order in orders %}
                {% for item in order.detail %}
            <tr  class='{{ (("made" if (isset(item.made) and item.made == "Y") else "")) }}  {{ (("halfmade" if (isset(item.made) and item.made == "H") else "")) }}  {{ (("priority" if ((isset(order['priority']) and order['priority'] == true)) else "")) }}'
                >

                
                <td><input type="checkbox" class="action" value="{{ item['orderId'] }}"> 
                {% if order['country'] != 'US' %}
                <i class="glyphicon glyphicon-globe"></i>{{ order['country'] }}
                {% endif %}
                <br/>
                {{ (("MADE" if (isset(item.made) and item.made == "Y") else "")) }}<br/>
                {{ (("HALFMADE" if (isset(item.made) and item.made == "H") else "")) }} 
                </td>
                <td>{{ substr(item['orderId'], -7) }} 
                    <span class="orderSpan" style="display:none">{{ item['orderId'] }}</span>
                    <a class="anchor" id="{{ substr(item['orderId'], -7) }}">{{ substr(item['orderId'], -7) }} </a>
                    <br/>
                    {% set multi = buyerStats[order.email] %}{% if count(multi) > 1 %}<br> Multi-orders {% for b in multi %}<br><a href='#{{ substr(b, -7) | safe }}'>{{ substr(b, -7) | safe }}</a><br>{% endfor %}{% endif %}
                    <br/>
                    <button class="btn btn-primary btn-lg prioritizeBtn" value="{{ item['orderId'] }}">
                        {{ (("UnPrioritize" if (isset(order['priority']) and order['priority'] == 1) else "Prioritize")) }}
                    </button>
                    
                </td>
                <td>{{ item['name'] }} 
                
                    <br/>
                    <textarea class="notes" >{% if isset(item['notes']) %}{{ item['notes'] | safe }}{% endif %}</textarea><br/>
                    <button class="saveNote" value="{{ item['itemId'] }}">Save</button>
                    <br/><span>Buyer : {{ order['buyer'] }}</span>
                </td>
                <td style="font-weight:bold;font-size:16pt">{{ item['qty'] }}</td>
                <td><a class="gallery" href="{{ (item['asin'] if (isset(item['asin'])) else '') }}"><img src="{{ (item['image'] if (isset(item['image'])) else '') }}" class="itemImage"></a></td>
                <td>{{ itemStats[item['asin']] }}</td>
                <!--<td>{{ num(item['days-past-promise']) + num(2) }} </td>-->

                <td>
                {{ date('Y-m-d', strtotime(cat(item.promiseDate, ' - 1 days'))) | safe }}
                        
                   <!--  <br/><br/> -->
                   <!-- {{ item['promiseDate'] }} -->
                    </td>

                <td>
                
                {% if hasRole(['user', 'admin']) %}
                <button class="btn btn-primary btn-lg showlabelBtn" value="{{ item['orderId'] }}">
                        Print Label
                    </button><br/><br/>
                    <button class="btn btn-primary packBtn" value="{{ item['orderId'] }}">
                        Packing
                    </button><br/>
                    <button class="btn btn-primary  madeBtn" value="{{ item['itemId'] }}">
                        {{ (("Unmade" if (isset(item['made']) and item['made'] == true) else "Made")) }}
                    </button><br/><br/>
                    <button class="btn btn-primary halfmadeBtn" value="{{ item['itemId'] }}">
                     {{ (("Un-HalfMade" if (isset(item.made) and item.made == "H") else "Half Made")) }}
                    </button>
                    <br/><br/>
                    <button class="btn btn-primary finishBtn" value="{{ item['orderId'] }}">
                        Finish
                    </button>
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
            {% endfor %}

        </tbody>
        <tfoot>
            <tr>
                <th>End</th>
                <th><span id="total_span"></span></th>
            </tr>
        </tfoot>
    </table>
    
	<script>

    var currentStore='Confirmed';
