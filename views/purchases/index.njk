{% extends "layout.njk" %}
{% block content %}
<style>
.finished{
    text-decoration: line-through;
}

.highlight{
    background-color:#7DCEA0;
}
</style>
<button class="btn btn-primary " id="createBtn">
  Create New
</button>
    <table class="table table-bordered table-condensed" id="purchases" >
        <thead>
            <tr>
                <th>id</th>
                <th>SKU</th>
                <th>Name</th>
                <th>Request Date</th>
                <th>Qty</th>
                <th>Current Qty</th>
                <th>Status</th>
                <th>Notes</th>
                <th>Pictures</th>
            </tr>
        </thead>
        <tbody>
            {% for purchase in purchases %}
            <tr >
                <td><a href="#" class="purchaseId" >{{ purchase.id }}</a>
                </td>
                <td>{{ purchase.sku }}
                </td>
                <td>{{ purchase.name }}
                </td>
                <td>{{ purchase.request_date }}
                </td>
                <td>{{ purchase.qty }}
		        </td>
                <td>{{ purchase.current_qty }}
		        </td>
                <td>{{ purchase.status }}
		        </td>
                <td style="padding:35px">{{ purchase.notes }}
		        </td>
                <td>
                {{ purchase.imagesHtml | safe }}
		        </td>
            </tr>
            {% endfor %}

        </tbody>
        <tfoot>
        </tfoot>
    </table>

    <!-- Modal -->
<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">&times;</span><span class="sr-only">Close</span></button>
        <h4 class="modal-title" id="myModalLabel">Create Purchase</h4>
      </div>
      <div class="modal-body">
      <form enctype="multipart/form-data" id="upload_form" role="form" method="POST" class="form-horizontal" action="" >
<fieldset>
<!-- Text input-->
<div class="control-group">
  <label class="control-label" for="name">Name</label>
  <div class="controls">
    <input id="name" name="name" type="text" placeholder="" class="input">
  </div>
</div>
<div class="control-group">
  <label class="control-label" for="sku">SKU</label>
  <div class="controls">
    <input id="sku" name="sku" type="text" placeholder="" class="input">
  </div>
</div>

<!-- Text input-->
<div class="control-group">
  <label class="control-label" for="request_date">Date</label>
  <div class="controls">
    <input id="request_date" name="request_date" type="text" placeholder="" class="datepicker" data-date-format="yyyy-mm-dd">
    
  </div>
</div>

<div class="control-group">
  <label class="control-label" for="status">Status</label>
  <div class="controls">
  <select id="status" name="status">
  <option value="pending">Pending
  <option value="Processing">Processing
  <option value="OnRoute">OnRoute
  <option value="Done">Done
  <option value="cancel">Cancel
  </select>
    
    
  </div>
</div>
<div class="control-group">
  <label class="control-label" for="qty">QTY</label>
  <div class="controls">
    <input id="qty" name="qty" type="text" placeholder="" class="input">
  </div>
</div>
<div class="control-group">
  <label class="control-label" for="sku">Current QTY</label>
  <div class="controls">
    <input id="current_qty" name="current_qty" type="text" placeholder="" class="input">
  </div>
</div>
<!-- Textarea -->
<div class="control-group">
  <label class="control-label" for="notes">Notes</label>
  <div class="controls">                     
    <textarea id="notes" name="notes" style="width:300px;height:200px"></textarea>
  </div>
</div>
<div class="control-group">
  <label class="control-label" for="images">Notes</label>
  <div class="controls" id="imageUploadControl">  
  
{{ form.file('images[]', {multiple: true}) | safe }}
  </div>
  <div class="controls" id="imagesDiv"></div>
</div>


</fieldset>
</form>
      </div>
      <div class="modal-footer">
        <button type="button" id="closeButton" class="btn btn-default" data-dismiss="modal">Close</button>
        <button type="button" id="saveNewButton" class="btn btn-primary">Create</button>
        <button type="button" id="updateButton" class="btn btn-info">Update</button>
        <button type="button" id="deleteButton" class="btn btn-danger">Delete</button>
      </div>
    </div>
  </div>
</div>
    <script>

$(document).ready(function() {
	$("#purchase").addClass("active");
$("#myModal").hide();
var purchaseId=0;
	
var oTable = $('#purchases').dataTable({
"bAutoWidth" : false, 
"aoColumns": [
{"sWidth": "50px"},
{"sWidth": "50px"},
{"sWidth": "150px"},
{"sWidth": "50px"},
{"sWidth": "50px"},
{"sWidth": "50px"},
{"sWidth": "50px"},
{"sWidth": "250px"},
{"sWidth": "250px"}
],
        "aaSorting": [[0, "desc"]],
        "sDom": "<'row-fluid'<'span6'l><'span6'f>r>t<'row-fluid'<'span12'i><'span12 center'p>>",
        "bPaginate": false,
        "oLanguage": {
        "sLengthMenu": "_MENU_ records per page"
        },
        "fnRowCallback": function(nRow, aData) {

        }
});

    $('#request_date').datepicker("option", "dateFormat", 'yy-mm-dd' );    
    $("#saveNewButton").click(function(){
            $.ajax({
                type : 'post',
                dataType:'json',
                url : '{{ url('Purchase.store')}}', // in here you should put your query 
                data:new FormData($("#upload_form")[0]),
                processData:false,//need this to process form
                contentType: false,
                // data :  'orderId=' + $("#orderId").val() + "&cs_user="+$("#cs_user").val() + "&request_date="+$("#request_date").val()+ "&assignTo="+$("#assignTo").val()+"&notes="+encodeURIComponent($("#notes").val())+"&done="+done, // here you pass your id via ajax .
                success : function(r)
                {
                    location.reload();
                    console.dir(r);
                },
                error: function(e){
                    console.dir(e);
                }
            });
    });
var today = new Date();
       var todayString = today.getFullYear()+'-'+(today.getMonth()+1)+'-'+today.getDate();
    $("#createBtn").click(function(){
        purchaseId='';
       $("#myModal").modal('show');
        $("#saveNewButton").show();
        $("#updateButton").hide();
        $("#deleteButton").hide();
        $("#name").val('');
        $("#qty").val('');
        $("#current_qty").val('');
        $("#sku").val('');
        $("#status").val('pending');
        $("#request_date").val(todayString);
        $("#imageUploadControl").show('');
         $( "input:file" ).replaceWith($( "input:file" ).val('').clone(true));
        $("#imagesDiv").html('');
        $("#notes").val('');
    });
    
    $("#closeButton").click(function(){
        purchaseId='';
        $("#name").val('');
        $("#qty").val('');
        $("#current_qty").val('');
        $("#sku").val('');
        $("#status").val('pending');
        $("#request_date").val('');
        $("#request_date").val('');
        $("#notes").val('');
        $("#imagesDiv").html('');
        
    });

    $("#deleteButton").click(function(){
        
        $.ajax({
        type : 'delete',
                url : '{{ url('Purchase.destroy')}}', // in here you should put your query c
                data :  'id=' + purchaseId, // here you pass your id via ajax .
                // in php you should use $_POST['post_id'] to get this value 
                success : function(r)
                {
                    purchaseId='';
                    $("#name").val('');
                    $("#qty").val('');
                    $("#current_qty").val('');
                    $("#sku").val('');
                    $("#status").val('pending');
                    $("#request_date").val('');
                    $("#notes").val('');
                    $("#imagesDiv").html('');
                    $("#myModal").modal('hide');
                    location.reload();
                },
                error: function(r)
                {
                    alert('error');
                    console.dir(r);
                }
        });
    });
    
    $("#updateButton").click(function(){
        $.ajax({
            type : 'put',
                    url : '{{ url('Purchase.update')}}', // in here you should put your query 
                    data :  'id='+purchaseId+'&name=' + $("#name").val() + "&request_date="+$("#request_date").val()+"&current_qty="+$("#current_qty").val()+"&sku="+$("#sku").val()+"&qty="+$("#qty").val()+"&notes="+encodeURIComponent($("#notes").val())+"&status="+$("#status").val(), // here you pass your id via ajax .
                    // in php you should use $_POST['post_id'] to get this value 
                    success : function(r)
                    {
                        purchaseId='';
                        $("#name").val('');
                        $("#qty").val('');
                        $("#current_qty").val('');
                        $("#sku").val('');
                        $("#status").val('pending');
                        $("#request_date").val('');
                        $("#request_date").val('');
                        $("#notes").val('');
                        $("#myModal").modal('hide');
                        location.reload();
                        console.dir(r);
                    },
                    error: function(r)
                    {
                        alert('error');
                        console.dir(r);
                    }
            });
    });
    

    $(".purchaseId").click(function(){
        var id = $(this).text();
       $.ajax({
        type : 'get',
                url : '{{ url('Purchase.show')}}', // in here you should put your query c
                data :  'id=' + id, // here you pass your id via ajax .
                // in php you should use $_POST['post_id'] to get this value 
                success : function(r)
                {
                    console.dir(r);
                    purchaseId = r.id;
                    $("#name").val(r.name);
                    $("#sku").val(r.sku);
                    $("#qty").val(r.qty);
                    $("#current_qty").val(r.current_qty);
                    $("#request_date").val(r.request_date);
                    $("#notes").val(r.notes);
                    $("#status").val(r.status);
                    
                    if(r.images!=null){
                        var followupImags = r.images.split("|||");
                        console.dir(followupImags);
                        var imagesHtml ="";
                        for(var i=0;i<followupImags.length;i++){
                            if(followupImags[i]!=''){
                                imagesHtml += "<img src='./storage/purchase/"+followupImags[i]+"' style='width:150px'>";

                            }
                        }
                    }
                    $("#imagesDiv").html(imagesHtml);
                    
                    $("#myModal").modal('show');
                    $("#imageUploadControl").hide();
                    $("#saveNewButton").hide();
                    $("#updateButton").show();
                    $("#deleteButton").show();
                }
        });
    });
});
    </script>	
{% endblock %}
