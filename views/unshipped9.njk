{% extends "unshipped_layout.njk" %}
{% block content %}
    <table class="table table-bordered table-condensed" id="orders" style="width:100%">
        <thead>
            <tr>
                <th class="hidden-xs"><input type="checkbox" id="chkAll"></th>
                <th class="hidden-xs">Order Number</th>
                <th class="hidden-xs">SKU</th>
                <th class="hidden-xs">Product Name</th>
                <th class="hidden-xs">Order Qty</th>
                <th class="hidden-xs">Product Picture</th>
                <th class="hidden-xs">Ship Date</th>
                <th class="hidden-xs">Total Qty</th>
                <th class="hidden-xs">days-past</th>
                <th class="hidden-xs">Print</th>
                <th class="hidden-lg hidden-md hidden-sm"></th>
            </tr>
        </thead>
        <tbody>
            {% for order in orders %}
                {% for item in order.detail %}
            <tr class='orderTr  {{ "urgent" if (isset(order.priority) and order.priority==2) else "" }} {{ "made" if (isset(item.made) and item.made=="Y") else "" }} {{ "inprogress" if (isset(item.made) and item.made=="P") else "" }}  {{ "halfmade" if (isset(item.made) and item.made=="H") else "" }} {{ item.priorityFlag }}'>

                
                <td class="hidden-xs">     
                <input type="checkbox" class="action" value="{{ item.orderId }}"> 
                {% if order.country!='US' %}
                <i class="glyphicon glyphicon-globe"></i>{{ order.country }}
                {% endif %}
                <br/>
                </td>
                
                <td class="hidden-xs">{{ item.orderId }} 
                <span style="display:none" class="store">{{ item.store }}</span>   
                    <a class="anchor" id="{{ substr(item.orderId,-7) }}">{{ item.orderId }} </a>
                    <br/>
                    {{ order.multiOrdersHtml | safe }}
                    <br/>
                    <button class="btn btn-primary btn-lg prioritizeBtn" value="{{ item.id }}">
                    {{ order.prioritizeBtnText }}
                    </button>
                    
                    {% if order.shippingCostPositive %}
                    <span>Buyer paid ${{ order.shippingCost }} shipping</span>
                    {% endif %}
                </td>
                <td class="hidden-xs">
                    <span class="externalSku" style="display:none">{{ item.asin }}</span> <br/>
                    <span class="externalAsin" >{{ item.asin }}</span> <br/>
                    <span >{{ item.sku }}</span> <br/>
                    {% if item.ProductMap is none %}
                        <button class="btn btn-sm btn-primary btnFindMatch">Find Match</button>
                        <span class="internalSku"></span>
                    {% else %}
                      <a class="internalSku">{{ item.ProductMap.sku }} {{ '' if (item.ProductMap.qty is none or item.ProductMap.qty == '') else (' x ' + item.ProductMap.qty) }}</a> 
                        <button class="btn btn-sm btn-primary btnFindMatch">Update Match</button>
                    {% endif %}
    
                        <div class="skuLocation"><br/>Location <br/>
                            {{ item.skuLocationHtml | safe }}
                        </div>
                    </td>
                <td class="hidden-xs">
                	{{ item.name }}<br/>
                <span style='color:black'> {{ str_replace("|",":",item.variation) }} </span>
				<span style='color:orange'> 
					{{ item.notesFromBuyerHtml | safe }}
					{{ item.selfNotesHtml | safe }}
				</span>
                    <br/>
                    <textarea class="notes" >{{ (item.notes if isset(item.notes) else '') | safe }}</textarea><br/>
                    <button class="saveNote" value="{{ item.id }}">Save</button>
                    <br/><span>Buyer : <a href="#" class="searchBuyer">{{ order.buyer }}</a></span>
                </td>
                <td class="hidden-xs" style="font-weight:bold;font-size:16pt;{{ 'color:#1e9ffe' if item.qty>1 else '' }}">{{ item.qty }}</td>
                <td class="hidden-xs">
                <a class="gallery" href="{{ item.image }}"><img src="{{ item.image }}" style="width:300px" class="itemImage">
                        <span class="orderIdvalue" style="display:none">{{ item.orderId }}</span>
						<span class="variantvalue" style="display:none">{{ item.variationValue }}</span>
						<span class="itemIdvalue" style="display:none">{{ item.itemID0 }}</span>
						</a></td>
				<td class="hidden-xs">
                    <span>
                        {{ item.shipDate }}</span>
                    <input type="text" type="text" class="form-control shipdate" value="{{ order.promiseDate }}">
    				<button value="{{ order.orderId }}" class="saveShipDateBtn">Update</button>
                </td>
                <td class="hidden-xs">{{ itemStats['a'+item.asin] if 'a'+item.asin in itemStats else '' }} </td>
                <td class="hidden-xs"></td>

                <td class="hidden-xs">

                {% if hasRole(['user','admin']) %}
                <table style="background-color: inherit;width:200px">
                <tr style="background-color: inherit ">
                <td style="vertical-align: top;">
                    <button class="btn btn-primary progressBtn {{ 'invisible' if (isset(item.made) and item.made=='Y') else '' }}"  value="{{ item.id }}">
                     {{ "In Progress" if (isset(item.made) and item.made=="P") else "Start Process" }}
                    </button>
                    <button class="btn btn-primary  madeBtn actionBtn" value="{{ item.id }}">
                        {{ "Unmade" if (item.made is not none and item.made != '' and item.made != '0') else "Made" }}
                    </button>
                    {% if hasRole(['packing','admin']) %}
                    <button class="btn btn-primary doneBtn actionBtn" value="{{ item.orderId }}">
                        Done
                    </button>
					<button class="btn btn-primary addTrackBtn actionBtn" value="{{ item.orderId }}">
						Add Tracking
          </button>
          {% endif %}
                </td>
                <td style="vertical-align: top;">     
                
                {% if hasRole(['packing','admin']) %} 
                               
                <button class="btn btn-primary btn-lg labelBtn actionBtn" value="{{ item.orderId }}">
                        Print Label
                    </button>   
                    {% if order.country=='US' or order.country=='USA' %}
                    <button class="btn btn-primary fedexPrint actionBtn" value="{{ item.orderId }}">
                        Fedex
                    </button>
                    {% endif %}
                {% endif %}
                </td>
                </tr>
                </table>
                {% endif %}
                </td>
                
                <td class="hidden-lg hidden-md hidden-sm">
                <p>{{ item.name }}<p>
                    <img width="320px" src="{{ item.image if isset(item.image) else '' }}" class="itemImage">
                    <br/>
                    <span class="orderSpan" style="display:none">{{ item.orderId }}</span>
                    <a class="anchor" id="{{ item.orderId }}">{{ item.orderId }} </a>
                    <br/>
                    {{ order.multiOrdersHtml | safe }}
					Notes: {{ (item.notes if isset(item.notes) else '') | safe }}<br/>
                    <span>Buyer : {{ order.buyer }}</span>
					<br/>
					Order QTY: {{ item.qty }}
					<br/>Same Item QTY: {{ itemStats['a'+item.asin] if 'a'+item.asin in itemStats else '' }} 
<br/>
<span class="externalSku" style="display:none">{{ item.asin }}</span> <br/>
                <span class="externalAsin" >{{ item.asin }}</span> <br/>
                {% if item.ProductMap is none %}
                    <button class="btn btn-sm btn-primary btnFindMatch">Find Match</button>
                    <span class="internalSku"></span>
                {% else %}
                  <a class="internalSku">{{ item.ProductMap.sku }} {{ '' if (item.ProductMap.qty is none or item.ProductMap.qty == '') else (' x ' + item.ProductMap.qty) }}</a> 
                    <button class="btn btn-sm btn-primary btnFindMatch">Update Match</button>
                {% endif %}

                    <div class="skuLocation"><br/>Location <br/>
                        {{ item.skuLocationHtml | safe }}
                    </div>
 <button class="btn btn-primary progressBtn {{ 'invisible' if (isset(item.made) and item.made=='Y') else '' }}"  value="{{ item.itemId }}">
                     {{ "In Progress" if (isset(item.made) and item.made=="P") else "Start Process" }}
                    </button>                    
                    <button class="btn btn-primary madeBtn"  value="{{ item.itemId }}">
                     {{ "Unmade" if (item.made == "Y") else "Made" }}
                    </button>
                </td>
            </tr>
            {% endfor %}
            {% endfor %}

        </tbody>
        <tfoot>
            <tr>
                <th>End</th>
                <th><span id="total_span"></span></th>
            </tr>
        </tfoot>
    </table>
    
	<script>
        
    var currentStore='W';
    
	$(document).ready(function() {
		$("#unshipped9").addClass("active");
        
		oTable = $('#orders').DataTable({
			"aoColumns": [{
				"sWidth": "50px"
			}, {
				"sWidth": "75px"
			}, {
				"sWidth": "75px"
			}, {
				"sWidth": "150px"
			}, {
				"sWidth": "50px"
			}, {
				"sWidth": "50%"
			}, {
				"sWidth": "50px"
			}, {
				"sWidth": "50px"
			}, {
				"sWidth": "50px"
			}, {
				"sWidth": "50px"
			}, {
			}],
			"aaSorting": [
				[5, "asc"]
			],
			"sDom": "<'row-fluid'<'span6'l><'boutonniereSearch'><'corsageSearch'><'bouquetSearch'><'quickSearch'><'span6'f<'clearSearch'>>r>t<'row-fluid'<'span12'i><'span12 center'p>>",
			"bPaginate": false,
			"oLanguage": {
				"sLengthMenu": "_MENU_ records per page"
			},
			"fnRowCallback": function(nRow, aData) {
			}
		});
        
});
	
	</script>
{% endblock %}
