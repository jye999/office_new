<script>              
    var amzMassPrinting = false;
    var amzMassPrintOrderArray = [];
    var amzMassPrintOrderUrlArray = [];
    var amzMassRates = null;
    var addOrderToTable = function(o,rate){
        var htmlToAdd = "<tr>";
        htmlToAdd += "<td>"+o.orderId+"</td>";
        if(rate==null){
            htmlToAdd += "<td>"+o.recipientName+"</td>";
            htmlToAdd += "<td>"+o.address1+"</td>";
            htmlToAdd += "<td>"+o.address2+"</td>";
            htmlToAdd += "<td>"+o.city+"</td>";
            htmlToAdd += "<td>"+o.state+"</td>";
            htmlToAdd += "<td>"+o.zip+"</td>";
            htmlToAdd += "<td></td>";
        }
        else{
            htmlToAdd += "<td>"+rate.Address.FullName+"</td>";
            htmlToAdd += "<td>"+rate.Address.Address1+"</td>";
            htmlToAdd += "<td>"+rate.Address.Address2+"</td>";
            htmlToAdd += "<td>"+rate.Address.City+"</td>";
            htmlToAdd += "<td>"+rate.Address.State+"</td>";
            htmlToAdd += "<td>"+rate.Address.ZIPCode+"</td>";
            htmlToAdd += "<td>"

            htmlToAdd += "<select class='selectRate'>";
            $.each(rate.Rates, function(idx, r) {
                
                var totalAmount = parseFloat(r.Amount);
                $.each(r.AddOns.AddOnV7, function(ix, ao){
                    if(ao.AddOnType=='US-A-INS'){
                        if($("#amzMass-insurance").val()>0){
                            totalAmount+=parseFloat(ao.Amount) ;
                        }
                    }
                    if(ao.AddOnType=='US-A-SC'){
                        if($("#amzMass-signature").prop('checked')){
                            totalAmount+=parseFloat(ao.Amount) ;
                        }
                    }
                });
                htmlToAdd += "<option value='"+r.ServiceType+"'>";
                switch (r.ServiceType) {
                    case 'US-FC':
                        htmlToAdd += 'USPS First-Class Mail';
                        break;
                    case 'US-MM':
                        htmlToAdd += 'USPS Media Mail';
                        break;
                    case 'US-PP':
                        htmlToAdd += 'USPS Parcel Post';
                        break;
                    case 'US-PM':
                        htmlToAdd += 'USPS Priority Mail';
                        break;
                    case 'US-GA':
                        htmlToAdd += 'USPS Ground Advantage';
                        break;
                    case 'US-XM':
                        htmlToAdd += 'USPS Priority Mail Express';
                        break;
                    case 'US-EMI':
                        htmlToAdd += 'USPS Priority Mail Express International';
                        break;
                    case 'US-PMI':
                        htmlToAdd += 'USPS Priority Mail International';
                        break;
                    case 'US-FCI':
                        htmlToAdd += 'USPS First Class Mail International';
                        break;
                    case 'US-CM':
                        htmlToAdd += 'USPS Critical Mail';
                        break;
                    case 'US-PS':
                        htmlToAdd += 'USPS Parcel Select';
                        break;
                    case 'US-LM':
                        htmlToAdd += 'USPS Library Mail';
                        break;
                }
                htmlToAdd +=  " -- " +totalAmount;
                htmlToAdd += "</option>";
            });
            htmlToAdd += "</select>";
            htmlToAdd += "</td>";
        }
        htmlToAdd += "</tr>";
        return htmlToAdd;
    }
    var pusherBinding = function(){

        var pusher = new Pusher("{{ env('PUSHER_KEY') }}");
            var channel = pusher.subscribe('label');

            channel.bind('App\\Events\\LabelDoneEvent', function(data) {

            console.log('An event was triggered with message: '+data.result);
            if(data.result.indexOf('failed')>-1){
                $.notify({
                    // options
                    message: data.result
                },{
                    // settings
                    type: 'danger',
                    delay: 0,
                });
            }
            else if(data.result.indexOf('success')>-1){
                $.notify({
                    // options
                    message: data.result
                },{
                    // settings
                    type: 'success',
                    delay: 0,
                });
            }
            else{
                $.notify({
                    // options
                    message: data.result
                },{
                    // settings
                    type: 'info',
                    delay: 10000,
                });
            }
            
            });
    }

    var pusherBinded = false;
    $(document).ready(function(){
        $('#amzMassPrintModal').modal('hide');
        $(document).on('click','#btnAmzMassPrint',function(){
            if(pusherBinded==false){
                pusherBinding();
                pusherBinded =true;
            }
            amzMassRates = null;
            amzMassPrinting = true;
            amzMassPrintOrderArray = [];
            var msg = '';
            $.each($( "input.action:checked" ), function( index, value ) {
                var toPrint = true;
                if ( amzMassPrintOrderArray.indexOf($(this).val()) <0 ){
                    if($(this).data('country') != 'US'){
                        msg += $(this).val() + ' is internation order\n';
                        toPrint = false;
                    }
                    if($(this).data('multiorder')>1){
                        msg += $(this).val() + ' has multiple orders\n';
                        toPrint = false;
                    }
                    if(toPrint){
                        amzMassPrintOrderArray.push($(this).val()); 
                    }
                    else{
                        $(this).prop('checked',false);
                    }
                }
            });
            if(msg!=''){
                alert('the following orders are removed from amzMass print\n'+msg);
            }
            if(amzMassPrintOrderArray.length<1){
                alert('Please select at least one order');
                return ;
            }
            $("#amzMass-total").html('print '+amzMassPrintOrderArray.length + ' orders');
            $("#amzMassLoadingModal").modal({
                backdrop: 'static'
            });
            console.dir(amzMassPrintOrderArray);
            $("#ordersToPrint").html('loading...');
            $.ajax({
                type:'post',
                datatype: 'json',
                url: '{{ route('getMultiOrders') }}', 
                data: {'orders': amzMassPrintOrderArray}, 
                success: function(r) {
                    console.dir(r);
                    if(r.length>0){
                        $("#ordersToPrint").html('');
                        $.each(r, function( index, elem ) {
                            var htmlToAdd = addOrderToTable(elem,null);
                            $("#ordersToPrint").append(htmlToAdd);
                        });
                    }
                    else{
                        $("#ordersToPrint").html('<tr><td colspan="8">cannot find orders</td></tr>');
                    }

                    $("#amzMassLoadingModal").modal('hide');
                },
                error: function(err){
                    console.dir(err);
                }
            });
            $('#amzMassPrintModal').modal({
               backdrop: 'static'
            });
        });

        $(document).on('click','#amzMassPrint-step2',function(){
            
            $('#amzMassPrintModal').modal('hide');
            // $("#amzMassLoadingModal").modal({
            //     backdrop: 'static'
            // });
            $.ajax({
                type:'post',
                datatype: 'json',
                url: '{{ route('getMultiAmzLabel') }}', 
                data: {
    					"orders": amzMassPrintOrderArray,
    					"lb": $("#amzMass-pound").val(),
    					"oz": $("#amzMass-ounce").val(),
    					"height": $("#amzMass-height").val(),
    					"width": $("#amzMass-width").val(),
    					"length": $("#amzMass-length").val()
                        
    				},
                success: function(r) {
                    $.each(amzMassPrintOrderArray, function( index, elem ) {
                            removeRowByOrderId(elem);
                    });
                    amzMassRates = r;

                    $("#amzMassPrintModal").modal('hide');
                    
                    // $('#amzMassPrintModal-step2').modal({
                    //     backdrop: 'static'
                    // });
                    // console.dir(r);
                    // if(r.length>0){
                    //     $("#ordersToPrint-2").html('');
                    //     $.each(r, function( index, elem ) {
                    //         var htmlToAdd = addOrderToTable(elem.order,elem.rate);
                    //         $("#ordersToPrint-2").append(htmlToAdd);
                    //     });
                    // }
                    // else{
                    //     $("#ordersToPrint").html('<tr><td colspan="8">cannot find orders</td></tr>');
                    // }

                    $("#amzMassLoadingModal").modal('hide');
                },
                error: function(err){
                    console.dir(err);
                }
            });
        });
        var processCount = 0;
        var sendToPrint = function(){
            ratesToSend = [];
            ratesToSend.push(amzMassRates[processCount]);
            console.log('processing ')
            console.dir(amzMassRates[processCount]);
            var msg = 'processing '+(processCount+1) + " / " + amzMassRates.length;
            $("#loadingMsg").text(msg);
            $.ajax({
                type:'post',
                datatype: 'json',
                url: '{{ route('buyMultiLabel') }}', 
                data: {
                    "rates": ratesToSend,
                    "signature": $("#amzMass-signature").prop('checked')
                },
                success: function(r) {
                    $.each(r, function( index, elem ) {
                        $('#amzMass-labelFrame').contents().find('body').append("<img src='" + elem['response'].URL + "' id='labelImage' style='width: 3.812in;height: 5.718in;'>");
                    });

                    processCount++;
                    if(processCount<amzMassRates.length){
                        sendToPrint();
                    }
                    else{
                        $("#loadingMsg").text('');
                        $("#amzMassLoadingModal").modal('hide');
                        $("#amzMassPrintModal-step2").modal('hide');
                        $("#amzMassPrintModal-step3").modal({
                            backdrop: 'static'
                        });
                    }
                },
                error: function(err){
                    console.dir(err);
                    alert('error '+amzMassRates[processCount].order.orderId);
                    processCount++;
                    if(processCount<amzMassRates.length){
                        sendToPrint();
                    }
                    else{
                        $("#loadingMsg").text('');
                        $("#amzMassLoadingModal").modal('hide');
                        $("#amzMassPrintModal-step2").modal('hide');

                        $("#amzMassPrintModal-step3").modal({
                            backdrop: 'static'
                        });
                    }
                }
            });
        }
        $(document).on('click','#amzMassPrint-step3',function(){

            $('#amzMassPrintModal-step2').modal('hide');
            $("#amzMassLoadingModal").modal({
                backdrop: 'static'
            });
            // console.log('step3');
            $.each($( ".selectRate" ), function( index, elem ) {
                var selectedRate = $(elem).val();
                var order=$(this).closest('tr').children('td:first').text();
                for(var i=0;i<amzMassRates.length;i++){
                    if(amzMassRates[i].order.orderId==order){
                        amzMassRates[i].selectedRate = selectedRate;
                        amzMassRates[i].order = {orderId: order};
                    }
                }
                
            });
            // var height = 5.718 * amzMassRates.length;
            // $("#amzMass-print-body3").html('');
            // $('<iframe />').remove();
            // $('<iframe />'); // Create an iframe element
            // $('<iframe />', {
            //     name: 'amzMass-labelFrame',
            //     id: 'amzMass-labelFrame',
            //     scrolling: 'no',
            //     frameborder: '0',
            //     style: "width: 3.812in; height: "+height+"in; border: 1px dashed black;"
            // }).appendTo('#amzMass-print-body3');

            // $('#amzMass-labelFrame').contents().find('body').html('');
            processCount = 0;
            sendToPrint();
        });

        var printLabelPdf = function(orders){
            $("#downloadFormPoster").remove();
            $("<div id='downloadFormPoster' style='display: none;'><iframe name='downloadFormPosterIframe'></iframe></div>").appendTo('body');
            $("<form id='pdflabelform' action='{{ route('printing') }}' target='downloadFormPosterIframe' method='post'></form>")
            .appendTo("#downloadFormPoster");
            $.each(orders, function(index,elem){
                $("#pdflabelform").append("<input type='hidden' name='orders[]' value='"+elem+"'/>" );
            });
            $("#pdflabelform").submit();
        };

		$(document).on('click', '#amzMassPrintBtn', function() {
            if(amzMassPrintOrderArray.length>0){
                printLabelPdf(amzMassPrintOrderArray);
            }
            else{
                alert('no orders to print');
            }
		});


		$(document).on('click', '#amzMass-Finish', function() {
            $("#amzMassLoadingModal").modal({
                backdrop: 'static'
            });
            window.location.reload();
		});
        
        $(document).on('click','#chkAll', function(){
            $('input:visible[type=checkbox].action').prop('checked',$(this).prop('checked'));
        });
   
    });
</script>