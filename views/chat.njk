<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="csrf-token" content="{{ csrf_token() }}">
    <title>Inventory AI Assistant</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f3f4f6;
            height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        /* Custom Scrollbar */
        .chat-scroll::-webkit-scrollbar {
            width: 6px;
        }
        .chat-scroll::-webkit-scrollbar-track {
            background: transparent;
        }
        .chat-scroll::-webkit-scrollbar-thumb {
            background-color: #cbd5e1;
            border-radius: 20px;
        }

        /* Animations */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .message-anim {
            animation: fadeIn 0.3s ease-out forwards;
        }

        .typing-dot {
            animation: typing 1.4s infinite ease-in-out both;
        }
        .typing-dot:nth-child(1) { animation-delay: -0.32s; }
        .typing-dot:nth-child(2) { animation-delay: -0.16s; }

        @keyframes typing {
            0%, 80%, 100% { transform: scale(0); }
            40% { transform: scale(1); }
        }

        /* Pulse animation for recording */
        @keyframes pulse-red {
            0%, 100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
            50% { box-shadow: 0 0 0 10px rgba(239, 68, 68, 0); }
        }
        .recording-pulse {
            animation: pulse-red 1.5s infinite;
        }

        /* Tablet: bigger fonts, bigger touch targets */
        @media (max-width: 1024px) {
            body { font-size: 20px; }
            #chat-container { padding: 20px; }
            #chat-container .text-sm { font-size: 20px !important; line-height: 1.7; }
            #chat-container .text-xs { font-size: 16px !important; }
            #chat-container .text-base { font-size: 22px !important; }
            #chat-container .text-lg { font-size: 24px !important; }
            #chat-container .rounded-2xl { padding: 18px; }
            #chat-container code { font-size: 17px !important; }
            #chat-container strong { font-size: inherit; }
            footer { padding: 20px; }
            footer textarea { font-size: 20px !important; min-height: 36px; padding: 10px 0; }
            footer .rounded-2xl { padding: 14px 18px; }
            footer .text-sm { font-size: 20px !important; }
            #send-btn { width: 56px; height: 56px; }
            #send-btn svg { width: 26px; height: 26px; }
            #mic-btn { width: 140px; height: 140px; }
            #mic-icon { width: 72px; height: 72px; }
            #mic-timer { font-size: 20px; }
            #mic-status { font-size: 16px !important; }
        }
        /* Phone: even bigger */
        @media (max-width: 480px) {
            body { font-size: 22px; }
            #chat-container { padding: 16px; }
            #chat-container .text-sm { font-size: 22px !important; line-height: 1.7; }
            #chat-container .text-xs { font-size: 18px !important; }
            #chat-container .text-base { font-size: 24px !important; }
            #chat-container .text-lg { font-size: 26px !important; }
            #chat-container .rounded-2xl { padding: 20px; }
            #chat-container code { font-size: 19px !important; }
            footer textarea { font-size: 22px !important; min-height: 40px; }
            footer .text-sm { font-size: 22px !important; }
            #send-btn { width: 60px; height: 60px; }
            #send-btn svg { width: 28px; height: 28px; }
            #mic-btn { width: 150px; height: 150px; }
            #mic-icon { width: 80px; height: 80px; }
            #mic-timer { font-size: 22px; }
            #mic-status { font-size: 18px !important; }
        }
    </style>
</head>
<body>


    <!-- Chat Area -->
    <main id="chat-container" class="flex-1 overflow-y-auto chat-scroll p-4 space-y-4 bg-gray-50">
        <!-- Welcome Message -->
        <div class="flex justify-start message-anim">
            <div class="max-w-[85%] md:max-w-[70%] bg-white border border-gray-200 rounded-2xl rounded-tl-none p-4 shadow-sm text-sm text-gray-700">
                <p>Hello! I am your Inventory Management Assistant .</p>
                <p class="mt-2 font-medium text-blue-600">Try saying: "Where is R020WY" or "产品R020WY在哪"</p>
                <p class="mt-2 text-xs text-gray-400">🎤 Tap the mic to start recording, tap again to stop</p>
            </div>
        </div>
    </main>

    <!-- Input Area -->
    <footer class="bg-white border-t border-gray-200 p-4 shrink-0 safe-area-bottom">
        <div class="max-w-4xl mx-auto flex items-end gap-2">
            <!-- Text Input -->
            <div class="flex-1 bg-gray-100 rounded-2xl flex items-center px-4 py-2 border border-transparent focus-within:border-blue-400 focus-within:bg-white focus-within:ring-2 focus-within:ring-blue-100 transition-all">
                <textarea 
                    id="user-input" 
                    rows="1" 
                    placeholder="Type a command or click mic to speak..." 
                    class="w-full bg-transparent border-none focus:ring-0 text-sm text-gray-800 resize-none max-h-32 py-2"
                    style="min-height: 24px;"
                    oninput="this.style.height = ''; this.style.height = this.scrollHeight + 'px'"
                    onkeydown="if(event.key === 'Enter' && !event.shiftKey) { event.preventDefault(); sendMessage(); }"
                ></textarea>
            </div>

            <!-- Send Button -->
            <button id="send-btn" onclick="sendMessage()" class="flex items-center justify-center w-10 h-10 rounded-full bg-blue-600 text-white hover:bg-blue-700 transition-colors shadow-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 transform rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                </svg>
            </button>
        </div>

        <!-- Microphone Button (tap to toggle) -->
        <div class="flex flex-col items-center mt-3">
            <button id="mic-btn" class="flex flex-col items-center justify-center rounded-full bg-gray-100 text-gray-500 hover:bg-gray-200 transition-all focus:outline-none focus:ring-2 focus:ring-blue-500 disabled:opacity-50 disabled:cursor-not-allowed shadow-sm select-none" style="width: 112px; height: 112px;" title="Tap to speak">
                <svg id="mic-icon" xmlns="http://www.w3.org/2000/svg" class="h-14 w-14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
                </svg>
                <span id="mic-timer" class="text-sm font-mono font-semibold hidden mt-1">0:00</span>
            </button>
            <p id="mic-status" class="text-[11px] text-gray-400 mt-1.5 font-medium">Tap to speak</p>
        </div>
    </footer>

    <script>
        const chatContainer = document.getElementById('chat-container');
        const userInput = document.getElementById('user-input');
        const micBtn = document.getElementById('mic-btn');
        const micIcon = document.getElementById('mic-icon');
        const micTimer = document.getElementById('mic-timer');
        const sendBtn = document.getElementById('send-btn');
        const micStatus = document.getElementById('mic-status');

        let isRecording = false;
        let audioStream = null;
        let recordingStartTime = null;
        let timerInterval = null;
        let conversationHistory = [];

        const hasMediaDevices = !!(navigator.mediaDevices && navigator.mediaDevices.getUserMedia);
        const MAX_RECORDING_MS = 60000;

        function formatTimer(ms) {
            const secs = Math.floor(ms / 1000);
            const m = Math.floor(secs / 60);
            const s = secs % 60;
            return m + ':' + String(s).padStart(2, '0');
        }

        function startTimer() {
            micTimer.classList.remove('hidden');
            micTimer.textContent = '0:00';
            timerInterval = setInterval(() => {
                if (recordingStartTime) {
                    const elapsed = Date.now() - recordingStartTime;
                    micTimer.textContent = formatTimer(elapsed);
                    if (elapsed >= MAX_RECORDING_MS) {
                        stopRecording();
                    }
                }
            }, 500);
        }

        function stopTimer() {
            clearInterval(timerInterval);
            timerInterval = null;
            micTimer.classList.add('hidden');
        }

        function setMicRecording(active) {
            isRecording = active;
            if (active) {
                micBtn.classList.add('bg-red-500', 'text-white', 'recording-pulse');
                micBtn.classList.remove('bg-gray-100', 'text-gray-500', 'hover:bg-gray-200');
                micIcon.classList.add('h-10', 'w-10');
                micIcon.classList.remove('h-14', 'w-14');
                micStatus.textContent = "Recording... tap to stop";
                startTimer();
            } else {
                micBtn.classList.remove('bg-red-500', 'text-white', 'recording-pulse');
                micBtn.classList.add('bg-gray-100', 'text-gray-500', 'hover:bg-gray-200');
                micIcon.classList.remove('h-10', 'w-10');
                micIcon.classList.add('h-14', 'w-14');
                stopTimer();
            }
        }

        // ── Audio recording via AudioContext → WAV ──

        let audioContext = null;
        let sourceNode = null;
        let processorNode = null;
        let pcmChunks = [];

        function float32ToInt16(float32Array) {
            const int16 = new Int16Array(float32Array.length);
            for (let i = 0; i < float32Array.length; i++) {
                const s = Math.max(-1, Math.min(1, float32Array[i]));
                int16[i] = s < 0 ? s * 0x8000 : s * 0x7FFF;
            }
            return int16;
        }

        function encodeWav(samples, sampleRate) {
            const buffer = new ArrayBuffer(44 + samples.length * 2);
            const view = new DataView(buffer);
            function writeStr(offset, str) {
                for (let i = 0; i < str.length; i++) view.setUint8(offset + i, str.charCodeAt(i));
            }
            writeStr(0, 'RIFF');
            view.setUint32(4, 36 + samples.length * 2, true);
            writeStr(8, 'WAVE');
            writeStr(12, 'fmt ');
            view.setUint32(16, 16, true);
            view.setUint16(20, 1, true);
            view.setUint16(22, 1, true);
            view.setUint32(24, sampleRate, true);
            view.setUint32(28, sampleRate * 2, true);
            view.setUint16(32, 2, true);
            view.setUint16(34, 16, true);
            writeStr(36, 'data');
            view.setUint32(40, samples.length * 2, true);
            const output = new Int16Array(buffer, 44);
            output.set(samples);
            return new Blob([buffer], { type: 'audio/wav' });
        }

        async function startRecording() {
            try {
                pcmChunks = [];
                audioStream = await navigator.mediaDevices.getUserMedia({
                    audio: { echoCancellation: true, noiseSuppression: true, channelCount: 1 }
                });

                audioContext = new (window.AudioContext || window.webkitAudioContext)({ sampleRate: 16000 });
                sourceNode = audioContext.createMediaStreamSource(audioStream);
                processorNode = audioContext.createScriptProcessor(4096, 1, 1);

                processorNode.onaudioprocess = (e) => {
                    const data = e.inputBuffer.getChannelData(0);
                    pcmChunks.push(new Float32Array(data));
                };

                sourceNode.connect(processorNode);
                processorNode.connect(audioContext.destination);

                recordingStartTime = Date.now();
                setMicRecording(true);
            } catch (error) {
                console.error('Failed to start recording:', error);
                let msg = "Microphone error.";
                if (error.name === 'NotAllowedError') msg = "Microphone permission denied. Allow it in browser settings.";
                else if (error.name === 'NotFoundError') msg = "No microphone found.";
                else if (error.name === 'NotReadableError') msg = "Microphone in use by another app.";
                micStatus.textContent = msg;
                setMicRecording(false);
            }
        }

        function stopRecording() {
            micStatus.textContent = "Transcribing...";
            setMicRecording(false);

            if (processorNode) { processorNode.disconnect(); processorNode = null; }
            if (sourceNode) { sourceNode.disconnect(); sourceNode = null; }
            if (audioStream) { audioStream.getTracks().forEach(t => t.stop()); audioStream = null; }

            if (pcmChunks.length === 0) {
                micStatus.textContent = "No audio captured. Try again.";
                if (audioContext) { audioContext.close(); audioContext = null; }
                return;
            }

            let totalLength = 0;
            for (const c of pcmChunks) totalLength += c.length;
            const merged = new Float32Array(totalLength);
            let offset = 0;
            for (const c of pcmChunks) { merged.set(c, offset); offset += c.length; }
            pcmChunks = [];

            const sampleRate = audioContext ? audioContext.sampleRate : 16000;
            if (audioContext) { audioContext.close(); audioContext = null; }

            const int16 = float32ToInt16(merged);
            const wavBlob = encodeWav(int16, sampleRate);

            console.log('WAV blob size:', wavBlob.size, 'bytes, duration ~' + (merged.length / sampleRate).toFixed(1) + 's');
            transcribeAudio(wavBlob);
        }

        async function transcribeAudio(blob) {
            micStatus.textContent = "Transcribing...";
            micBtn.disabled = true;
            sendBtn.disabled = true;

            const formData = new FormData();
            formData.append('audio', blob, 'recording.wav');

            try {
                const response = await fetch('{{ route("chat.transcribe") }}', {
                    method: 'POST',
                    headers: {
                        'X-CSRF-TOKEN': '{{ csrf_token() }}',
                        'Accept': 'application/json',
                    },
                    body: formData,
                });

                const data = await response.json();

                if (data.success && data.text) {
                    micStatus.textContent = "Tap to speak";
                    await sendTranscribedMessage(data.text);
                } else if (!response.ok) {
                    micStatus.textContent = data.error || "Transcription failed. Try again.";
                } else {
                    micStatus.textContent = "Couldn't hear you. Tap mic and speak clearly.";
                }
            } catch (error) {
                console.error('Transcription request failed:', error);
                micStatus.textContent = "Transcription failed. Check connection.";
            } finally {
                micBtn.disabled = false;
                sendBtn.disabled = false;
            }
        }

        // ── Tap to toggle mic ──

        micBtn.addEventListener('click', async (e) => {
            e.preventDefault();
            if (micBtn.disabled) return;

            if (!hasMediaDevices) {
                micStatus.textContent = "Voice input requires HTTPS.";
                return;
            }

            if (isRecording) {
                stopRecording();
            } else {
                await startRecording();
            }
        });

        // ── Send transcribed voice text directly to LLM ──

        async function sendTranscribedMessage(text) {
            appendMessage(text, 'user');
            sendBtn.disabled = true;
            micBtn.disabled = true;

            const typingId = showTypingIndicator();

            try {
                const response = await fetch('{{ route("chat.send") }}', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': '{{ csrf_token() }}',
                        'Accept': 'application/json',
                    },
                    body: JSON.stringify({
                        message: text,
                        history: conversationHistory,
                    }),
                });

                const data = await response.json();
                removeTypingIndicator(typingId);

                if (data.success) {
                    appendMessage(formatMarkdown(data.reply), 'bot');
                    conversationHistory = data.history || [];
                } else {
                    const errorDetail = data.error ? `\n\n<span class="text-xs text-red-400">${data.error}</span>` : '';
                    appendMessage('Something went wrong.' + errorDetail, 'bot');
                }
            } catch (error) {
                removeTypingIndicator(typingId);
                appendMessage('Network error. Please check your connection and try again.', 'bot');
            } finally {
                sendBtn.disabled = false;
                micBtn.disabled = false;
                userInput.focus();
            }
        }

        function appendMessage(text, sender) {
            const div = document.createElement('div');
            div.className = `flex ${sender === 'user' ? 'justify-end' : 'justify-start'} message-anim`;
            
            const bubble = document.createElement('div');
            bubble.className = `max-w-[85%] md:max-w-[70%] rounded-2xl p-4 shadow-sm text-sm ${
                sender === 'user' 
                ? 'bg-blue-600 text-white rounded-tr-none' 
                : 'bg-white border border-gray-200 text-gray-700 rounded-tl-none'
            }`;
            
            bubble.innerHTML = text.replace(/\n/g, '<br>');
            div.appendChild(bubble);
            chatContainer.appendChild(div);
            chatContainer.scrollTop = chatContainer.scrollHeight;
        }

        function showTypingIndicator() {
            const id = 'typing-' + Date.now();
            const div = document.createElement('div');
            div.id = id;
            div.className = 'flex justify-start message-anim';
            div.innerHTML = `
                <div class="bg-white border border-gray-200 rounded-2xl rounded-tl-none p-4 shadow-sm flex items-center gap-1 h-12 w-16 justify-center">
                    <div class="w-2 h-2 bg-gray-400 rounded-full typing-dot"></div>
                    <div class="w-2 h-2 bg-gray-400 rounded-full typing-dot"></div>
                    <div class="w-2 h-2 bg-gray-400 rounded-full typing-dot"></div>
                </div>
            `;
            chatContainer.appendChild(div);
            chatContainer.scrollTop = chatContainer.scrollHeight;
            return id;
        }

        function removeTypingIndicator(id) {
            const el = document.getElementById(id);
            if (el) el.remove();
        }

        async function sendMessage() {
            const text = userInput.value.trim();
            if (!text) return;

            appendMessage(text, 'user');
            userInput.value = '';
            userInput.style.height = 'auto';
            sendBtn.disabled = true;
            micBtn.disabled = true;

            const typingId = showTypingIndicator();

            try {
                const response = await fetch('{{ route("chat.send") }}', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': '{{ csrf_token() }}',
                        'Accept': 'application/json',
                    },
                    body: JSON.stringify({
                        message: text,
                        history: conversationHistory,
                    }),
                });

                const data = await response.json();
                removeTypingIndicator(typingId);

                if (data.success) {
                    appendMessage(formatMarkdown(data.reply), 'bot');
                    conversationHistory = data.history || [];
                } else {
                    const errorDetail = data.error ? `\n\n<span class="text-xs text-red-400">${data.error}</span>` : '';
                    appendMessage('⚠️ ' + (data.reply || 'Something went wrong.') + errorDetail, 'bot');
                }
            } catch (error) {
                removeTypingIndicator(typingId);
                console.error('Chat error:', error);
                appendMessage('⚠️ Network error. Please check your connection and try again.', 'bot');
            } finally {
                sendBtn.disabled = false;
                micBtn.disabled = false;
                userInput.focus();
            }
        }

        function formatMarkdown(text) {
            if (!text) return '';
            return text
                .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                .replace(/\*(.*?)\*/g, '<em>$1</em>')
                .replace(/`(.*?)`/g, '<code class="bg-gray-100 text-gray-800 px-1 rounded text-xs">$1</code>')
                .replace(/^### (.*$)/gm, '<h3 class="font-semibold text-base mt-2 mb-1">$1</h3>')
                .replace(/^## (.*$)/gm, '<h2 class="font-semibold text-lg mt-2 mb-1">$1</h2>')
                .replace(/^- (.*$)/gm, '<span class="block ml-3">• $1</span>')
                .replace(/^\d+\. (.*$)/gm, function(match, p1, offset, str) {
                    return '<span class="block ml-3">' + match.replace(/^(\d+\.)/, '<strong>$1</strong>') + '</span>';
                });
        }

        function clearChat() {
            chatContainer.innerHTML = '';
            conversationHistory = [];
            appendMessage("Chat history cleared. Ready for new commands.", 'bot');
        }

        window.addEventListener('DOMContentLoaded', () => {
            if (!hasMediaDevices) {
                micBtn.disabled = true;
                micBtn.classList.add('opacity-50', 'cursor-not-allowed');
                micBtn.title = "Voice input unavailable";
                micStatus.textContent = "Voice requires HTTPS.";
            } else {
                micStatus.textContent = "Tap to speak";
            }
            userInput.focus();
        });
    </script>
</body>
</html>

