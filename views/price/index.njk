				<h4 class="modal-title" id="myModalLabel">Create Follow up</h4>
			</div>
			<div class="modal-body">
				<div id="listReq">
					<table class="table table-bordered table-hover" id="reqTable">
						<thead>
							<tr>
								<td>ID </td>
								<td>Name</td>
								<td>Color</td>
								<td>Wedding Date</td>
								<td>Comment</td>
								<td>Email</td>
								<td>Phone</td>
							</tr>
						</thead>
						<tbody>
						</tbody>
					</table>
				</div>
			</div>

			<div class="modal-footer">
				<button type="button" id="closeButton" class="btn btn-default" data-dismiss="modal">Close</button>
			</div>
		</div>
	</div>
</div>
<script>
$(document).ready(function(){
	var recal = function(id){
		var unit=parseFloat($("#"+id+"_base").val());
		$("input[name='"+id+"_options[]']:checked").each(function ()
		{
			unit += parseFloat($(this).val());
		});
		$("input[name='"+id+"_options_color']:checked").each(function ()
		{
			unit += parseFloat($(this).val());
		});
		$("#"+id+"_price").val(unit.toFixed(2) );
		$("#"+id+"_total").val((unit * parseInt($("#"+id+"_qty").val())).toFixed(2));
		calGrandTotal();

	};


	var recalOther = function(id){
		var unit=parseFloat($("#"+id+"_base").val());
		
		$("input[name='"+id+"_options']:checked").each(function ()
		{
			unit += parseFloat($(this).val());
		});
		$("#"+id+"_price").val(unit.toFixed(2) );
		$("#"+id+"_total").val((unit * parseInt($("#"+id+"_qty").val())).toFixed(2));
		calGrandTotal();

	};

	var calGrandTotal = function(){

		var grandTotal = 0.0;
		$(".total").each(function ()
		{
			if(!isNaN($(this).val().trim()) && $(this).val().trim() !=''){
				grandTotal += parseFloat($(this).val().trim());
			}
		});
		$("#grandTotal").val(grandTotal.toFixed(2));
	}

	$("#round_qty").change(function(){
		recal("round");
	});
	$("input[name='round_options[]']").change(function(){
		recal("round");
	});
	$("input[name='round_options_color']").change(function(){
		recal("round");
	});

	$("#moh_qty").change(function(){
		recal("moh");
	});
	$("input[name='moh_options[]']").change(function(){
		recal("moh");
	});
	$("input[name='moh_options_color']").change(function(){
		recal("moh");
	});

	$("#bb_qty").change(function(){
		recal("bb");
	});
	$("input[name='bb_options[]']").change(function(){
		recal("bb");
	});
	$("input[name='bb_options_color']").change(function(){
		recal("bb");
	});

	$("#fg_qty").change(function(){
		recal("fg");
	});
	$("input[name='fg_options[]']").change(function(){
		recal("fg");
	});
	$("input[name='fg_options_color']").change(function(){
		recal("fg");
	});

	$("#toss_qty").change(function(){
		recal("toss");
	});
	$("input[name='toss_options[]']").change(function(){
		recal("toss");
	});
	$("input[name='toss_options_color']").change(function(){
		recal("toss");
	});


	$("#groom_qty").change(function(){
		recalOther("groom");
	});
	$("input[name='groom_options']").change(function(){
		recalOther("groom");
	});

	$("#bestman_qty").change(function(){
		recalOther("bestman");
	});
	$("input[name='bestman_options']").change(function(){
		recalOther("bestman");
	});

	$("#groomsmen_qty").change(function(){
		recalOther("groomsmen");
	});
	$("input[name='groomsmen_options']").change(function(){
		recalOther("groomsmen");
	});

	$("#other_qty").change(function(){
		recalOther("other");
	});
	$("input[name='other_options']").change(function(){
		recalOther("other");
	});

	$("#pincorsage_qty").change(function(){
		recalOther("pincorsage");
	});
	$("input[name='pincorsage_options']").change(function(){
