    <!-- Quick Inventory Update Modal -->
    <div class="modal fade" id="quickInventoryModal" tabindex="-1" role="dialog" aria-labelledby="quickInventoryModalLabel">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                    <h4 class="modal-title" id="quickInventoryModalLabel">Quick Inventory Update</h4>
                </div>
                <div class="modal-body">
                    <form id="quickInventoryForm">
                        <div class="form-group">
                            <label for="quickInventorySku">SKU <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="quickInventorySku" name="sku" required placeholder="Enter SKU">
                        </div>
                        <div class="form-group">
                            <label for="quickInventoryLocation">Location <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="quickInventoryLocation" name="location" required placeholder="Enter location">
                        </div>
                        <div class="form-group">
                            <label for="quickInventoryQty">Quantity <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="quickInventoryQty" name="qty" required placeholder="Enter quantity" min="0">
                        </div>
                        <div id="quickInventoryError" class="alert alert-danger" style="display: none;"></div>
                        <div id="quickInventorySuccess" style="display: none;">
                            <div class="alert alert-success">
                                <strong>Success!</strong> Inventory updated successfully.
                            </div>
                            <h5>Current Inventory for SKU: <span id="quickInventorySkuDisplay"></span></h5>
                            <table class="table table-bordered table-striped">
                                <thead>
                                    <tr>
                                        <th>Location</th>
                                        <th>Quantity</th>
                                    </tr>
                                </thead>
                                <tbody id="quickInventoryResults">
                                </tbody>
                            </table>
                        </div>
                        <div id="quickInventoryFindResults" style="display: none;">
                            <h5>Inventory Locations for SKU: <span id="quickInventoryFindSkuDisplay"></span>*</h5>
                            <p class="text-muted small">*Showing all SKUs starting with the entered pattern</p>
                            <table class="table table-bordered table-striped">
                                <thead>
                                    <tr>
                                        <th>SKU</th>
                                        <th>Location</th>
                                        <th>Quantity</th>
                                    </tr>
                                </thead>
                                <tbody id="quickInventoryFindResultsBody">
                                </tbody>
                            </table>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <div class="pull-left">
                        <button type="button" class="btn btn-info" id="quickInventoryFindBtn">
                            <span class="glyphicon glyphicon-search"></span> Find Location
                        </button>
                    </div>
                    <div class="pull-right">
                        <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                        <button type="button" class="btn btn-primary" id="quickInventorySubmitBtn">Update Inventory</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
    $(document).ready(function() {
        // Reset modal when closed
        $('#quickInventoryModal').on('hidden.bs.modal', function () {
            $('#quickInventoryForm')[0].reset();
            $('#quickInventoryError').hide();
            $('#quickInventorySuccess').hide();
            $('#quickInventoryFindResults').hide();
        });

        // Handle form submission
        $('#quickInventorySubmitBtn').on('click', function() {
            $('#quickInventoryFindResults').hide();
            $('#quickInventoryError').hide();
            $('#quickInventorySuccess').hide();
            
            
            var sku = $('#quickInventorySku').val().trim();
            var location = $('#quickInventoryLocation').val().trim();
            var qty = $('#quickInventoryQty').val();

            // Basic validation
            if (!sku || !location || qty === '') {
                $('#quickInventoryError').text('Please fill in all fields.').show();
                $('#quickInventorySuccess').hide();
                return;
            }

            // Disable button and show loading
            var $btn = $(this);
            $btn.prop('disabled', true).text('Updating...');
            $('#quickInventoryError').hide();
            $('#quickInventorySuccess').hide();

            // Submit via AJAX
            $.ajax({
                url: '{{ route("inventory.quickUpdate") }}',
                method: 'POST',
                data: {
                    sku: sku,
                    location: location,
                    qty: qty,
                    _token: '{{ csrf_token() }}'
                },
                success: function(response) {
                    if (response.success) {
                        // Display success message and results
                        $('#quickInventorySkuDisplay').text(response.sku);
                        var tbody = $('#quickInventoryResults');
                        tbody.empty();
                        
                        if (response.locations && response.locations.length > 0) {
                            $.each(response.locations, function(index, item) {
                                tbody.append('<tr><td>' + item.location + '</td><td>' + item.qty + '</td></tr>');
                            });
                        } else {
                            tbody.append('<tr><td colspan="2" class="text-center">No inventory found</td></tr>');
                        }
                        
                        $('#quickInventorySuccess').show();
                        $('#quickInventoryError').hide();
                    } else {
                        $('#quickInventoryError').text(response.message || 'An error occurred.').show();
                        $('#quickInventorySuccess').hide();
                    }
                },
                error: function(xhr) {
                    var errorMsg = 'An error occurred.';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMsg = xhr.responseJSON.message;
                    } else if (xhr.responseJSON && xhr.responseJSON.error) {
                        errorMsg = xhr.responseJSON.error;
                    } else if (xhr.status === 404) {
                        errorMsg = 'SKU not found.';
                    }
                    $('#quickInventoryError').text(errorMsg).show();
                    $('#quickInventorySuccess').hide();
                },
                complete: function() {
                    $btn.prop('disabled', false).text('Update Inventory');
                }
            });
        });

        // Allow Enter key to submit
        $('#quickInventoryForm input').on('keypress', function(e) {
            if (e.which === 13) {
                e.preventDefault();
                $('#quickInventorySubmitBtn').click();
            }
        });

        // Handle Find Location button
        $('#quickInventoryFindBtn').on('click', function() {
            $('#quickInventoryFindResults').hide();
            $('#quickInventoryError').hide();
            $('#quickInventorySuccess').hide();
            var sku = $('#quickInventorySku').val().trim();

            // Basic validation
            if (!sku) {
                $('#quickInventoryError').text('Please enter a SKU to find locations.').show();
                $('#quickInventorySuccess').hide();
                $('#quickInventoryFindResults').hide();
                return;
            }

            // Disable button and show loading
            var $btn = $(this);
            $btn.prop('disabled', true).html('<span class="glyphicon glyphicon-refresh glyphicon-spin"></span> Searching...');
            $('#quickInventoryError').hide();
            $('#quickInventorySuccess').hide();

            // Submit via AJAX
            $.ajax({
                url: '{{ route("inventory.findLocations") }}',
                method: 'GET',
                data: {
                    sku: sku
                },
                success: function(response) {
                    if (response.success) {
                        // Display results
                        $('#quickInventoryFindSkuDisplay').text(response.sku_pattern);
                        var tbody = $('#quickInventoryFindResultsBody');
                        tbody.empty();
                        
                        if (response.locations && response.locations.length > 0) {
                            $.each(response.locations, function(index, item) {
                                tbody.append('<tr><td>' + item.sku + '</td><td>' + item.location + '</td><td>' + item.qty + '</td></tr>');
                            });
                        } else {
                            tbody.append('<tr><td colspan="3" class="text-center">No inventory found for this SKU pattern</td></tr>');
                        }
                        
                        $('#quickInventoryFindResults').show();
                        $('#quickInventoryError').hide();
                    } else {
                        $('#quickInventoryError').text(response.message || 'An error occurred.').show();
                        $('#quickInventoryFindResults').hide();
                    }
                },
                error: function(xhr) {
                    var errorMsg = 'An error occurred.';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMsg = xhr.responseJSON.message;
                    } else if (xhr.responseJSON && xhr.responseJSON.error) {
                        errorMsg = xhr.responseJSON.error;
                    } else if (xhr.status === 404) {
                        errorMsg = 'SKU not found.';
                    }
                    $('#quickInventoryError').text(errorMsg).show();
                    $('#quickInventoryFindResults').hide();
                },
                complete: function() {
                    $btn.prop('disabled', false).html('<span class="glyphicon glyphicon-search"></span> Find Location');
                }
            });
        });
    });
    </script>
