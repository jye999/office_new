                alert('dimensions are required');
                return;
            }
            $("#fedex-ground-rate").text('loading...');
            $.ajax({
                type: 'post',
                dataType: 'json',
                url: '{{ route('fedex.getrate') }}', // in here you should put your query 
                data: {
                    "address": address,
                    "lb": $("#pound").val(),
                    "oz": $("#ounce").val(),
                    "height": $("#height").val(),
                    "width": $("#width").val(),
                    "length": $("#length").val(),
                    "isResidential": $("#residential").prop('checked')
                },
                success: function(r) {
                    console.dir(r);
                    $("#fedex-ground-rate").text("$"+r[0].amount+ " "+r[0].deliveryDate);
                },
                error: function(xhr, textStatus, errorThrown) {
                }
            });
            
});
