{% extends "layout.njk" %}
{% block content %}
<br/><br/>

    <table class="table table-bordered table-condensed" id="actionlogstable" >
        <thead>
            <tr>
                <th>id</th>
                <th>User</th>
                <th>Action</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
            {% for al in actionlogs %}
            <tr >
                <td>{{ al.id }}</td>
                <td>{{ al.user_name }}</td>
                <td>{{ al.action }}</td>
                <td>{{ al.created_at }}</td>
		        </td>
                
            </tr>
            {% endfor %}

        </tbody>
    </table>

    <script>

$(document).ready(function() {
var oTable = $('#actionlogstable').dataTable({
"bAutoWidth" : false, 
"aoColumns": [
{"sWidth": "50px"},
{"sWidth": "150px"},
{"sWidth": "200px"},
{"sWidth": "50px"}
],
        "aaSorting": [[0, "desc"]],
        "sDom": "<'row-fluid'<'span6'l><'span6'f>r>t<'row-fluid'<'span12'i><'span12 center'p>>",
        "bPaginate": false,
        "oLanguage": {
        "sLengthMenu": "_MENU_ records per page"
        },
        "fnRowCallback": function(nRow, aData) {

        }
});

});
    </script>	
{% endblock %}
