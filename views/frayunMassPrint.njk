    <div class="modal fade" id="frayunMassPrintModal-step3" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <button type="button" class="btn btn-default" data-dismiss="modal" id="frayunMass-Finish" >Close</button>

                    <button type="button" class="btn btn-primary" id="frayunMassPrintBtn">Download Labels</button>
